  "review_response_tasks": [
    {
      "number": 1,
      "stem": "The form is missing a signature, so the office cannot ____ the application yet. It remains unprocessed.",
      "options": [
        [
          "A",
          "consume"
        ],
        [
          "B",
          "forecast"
        ],
        [
          "C",
          "process"
        ],
        [
          "D",
          "forgive"
        ]
      ],
      "answer": "C",
      "rationale": "process：process办理申请与unprocessed对应；consume消耗/forecast预测/forgive原谅不表办理手续。"
    },
    {
      "number": 2,
      "stem": "The tutor asked for a ____ account: include the main steps, but leave out unrelated details.",
      "options": [
        [
          "A",
          "hostile"
        ],
        [
          "B",
          "accidental"
        ],
        [
          "C",
          "permanent"
        ],
        [
          "D",
          "concise"
        ]
      ],
      "answer": "D",
      "rationale": "concise：保留mainsteps删无关细节=concise简洁；permanent永久/hostile敌对/accidental偶然不表篇幅精炼。"
    },
    {
      "number": 3,
      "stem": "The note is marked “provisional”, which means the arrangement is ____. It may still change.",
      "options": [
        [
          "A",
          "irreversible"
        ],
        [
          "B",
          "compulsory"
        ],
        [
          "C",
          "invisible"
        ],
        [
          "D",
          "temporary"
        ]
      ],
      "answer": "D",
      "rationale": "temporary：maychange对应temporary暂定；irreversible不可逆反，compulsory强制/invisible不可见非暂定。"
    },
    {
      "number": 4,
      "stem": "She decided to ____ the offer rather than accept work she could not complete.",
      "options": [
        [
          "A",
          "decline"
        ],
        [
          "B",
          "estimate"
        ],
        [
          "C",
          "preserve"
        ],
        [
          "D",
          "compose"
        ]
      ],
      "answer": "A",
      "rationale": "decline：ratherthanaccept拒绝decline；compose创作/preserve保留/estimate估算不表示拒offer。"
    },
    {
      "number": 5,
      "stem": "The new rule applies ____ all members, including those who joined last week.",
      "options": [
        [
          "A",
          "at"
        ],
        [
          "B",
          "for"
        ],
        [
          "C",
          "of"
        ],
        [
          "D",
          "to"
        ]
      ],
      "answer": "D",
      "rationale": "to：applyto适用于；applyat/for/of不能在此表示规则适用对象。"
    },
    {
      "number": 6,
      "stem": "The author, ____ first novel won a local prize, will speak on Friday.",
      "options": [
        [
          "A",
          "who"
        ],
        [
          "B",
          "whom"
        ],
        [
          "C",
          "which"
        ],
        [
          "D",
          "whose"
        ]
      ],
      "answer": "D",
      "rationale": "whose：从句firstnovel前需所属whose；who主格不修饰novel，which物，whom宾格。"
    },
    {
      "number": 7,
      "stem": "____ in plain language, the instructions were easy for newcomers to follow.",
      "options": [
        [
          "A",
          "Writes"
        ],
        [
          "B",
          "To write"
        ],
        [
          "C",
          "Writing"
        ],
        [
          "D",
          "Written"
        ]
      ],
      "answer": "D",
      "rationale": "Written：instructions被写用Written分词；Writing主动主语不合，Towrite目的主语应写者，Writes限定不能作状语。"
    },
    {
      "number": 8,
      "stem": "The hall was empty when we arrived because everyone ____ already left.",
      "options": [
        [
          "A",
          "will"
        ],
        [
          "B",
          "had"
        ],
        [
          "C",
          "has"
        ],
        [
          "D",
          "is"
        ]
      ],
      "answer": "B",
      "rationale": "had：到达过去之前已离开hadleft；has现在完成，will后left错，isleft被留非主动离开。"
    },
    {
      "number": 9,
      "stem": "____ surprised the visitors was the small size of the original model.",
      "options": [
        [
          "A",
          "That"
        ],
        [
          "B",
          "What"
        ],
        [
          "C",
          "Whether"
        ],
        [
          "D",
          "Who"
        ]
      ],
      "answer": "B",
      "rationale": "What：What引主语从句并作surprised主语；That不充缺少的主语，Whether不充名词角色，Who把让人惊讶的物误作人且后model非人。"
    },
    {
      "number": 10,
      "stem": "The question is ____ we can finish before the room closes.",
      "options": [
        [
          "A",
          "what"
        ],
        [
          "B",
          "whose"
        ],
        [
          "C",
          "whether"
        ],
        [
          "D",
          "who"
        ]
      ],
      "answer": "C",
      "rationale": "whether：完整wecanfinish无名词缺口，whether引能否；what/who需句内成分，whose需所属名词。"
    },
    {
      "number": 11,
      "stem": "We missed the train. If we had left ten minutes earlier, we ____ caught it.",
      "options": [
        [
          "A",
          "are"
        ],
        [
          "B",
          "is"
        ],
        [
          "C",
          "will"
        ],
        [
          "D",
          "would have"
        ]
      ],
      "answer": "D",
      "rationale": "would have：已错过的过去反事实wouldhavecaught；will后caught错，are/is被捕与赶车施受反且主语we不配is。"
    },
    {
      "number": 12,
      "stem": "By next Friday, the team ____ completed all three interviews.",
      "options": [
        [
          "A",
          "will have"
        ],
        [
          "B",
          "will"
        ],
        [
          "C",
          "were"
        ],
        [
          "D",
          "is"
        ]
      ],
      "answer": "A",
      "rationale": "will have：byfuture完成willhavecompleted；will后须complete，is/werecompleted被动主语team方向/数不合。"
    },
    {
      "number": 13,
      "stem": "Despite ____ tired, she checked the figures once more.",
      "options": [
        [
          "A",
          "be"
        ],
        [
          "B",
          "were"
        ],
        [
          "C",
          "being"
        ],
        [
          "D",
          "was"
        ]
      ],
      "answer": "C",
      "rationale": "being：despite介词后being动名词；was/were限定不能直接作介词宾语，be原形不合。"
    },
    {
      "number": 14,
      "stem": "To her ____, the parcel contained the notebook she had lost.",
      "options": [
        [
          "A",
          "surprisingly"
        ],
        [
          "B",
          "surprise"
        ],
        [
          "C",
          "surprised"
        ],
        [
          "D",
          "surprising"
        ]
      ],
      "answer": "B",
      "rationale": "surprise：toonesurprise名词固定；surprised/surprising形容或分词，surprisingly副词不作her后的名词。"
    },
    {
      "number": 15,
      "stem": "The teacher asked me what ____ before the alarm rang.",
      "options": [
        [
          "A",
          "had I seen"
        ],
        [
          "B",
          "I have seeing"
        ],
        [
          "C",
          "I had seen"
        ],
        [
          "D",
          "did I see"
        ]
      ],
      "answer": "C",
      "rationale": "I had seen：宾语从句陈述序Ihadseen且过去此前；hadIseen/didIsee倒装问句序，have seeing结构错。"
    }

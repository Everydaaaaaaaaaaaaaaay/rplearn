    },
    {
      "number": 3,
      "stem": "My desk is 80 cm wide. Yours is 60 cm wide. My desk is ____ than yours.",
      "options": [
        [
          "A",
          "wider"
        ],
        [
          "B",
          "wide"
        ],
        [
          "C",
          "widest"
        ]
      ],
      "answer": "A",
      "rationale": "明示80>60且than需比较级wider；wide原级、widest最高级不合该结构。数值为虚构设定，不用鲸寿命事实。"
    },
    {
      "number": 4,
      "stem": "We ____ the windows yesterday afternoon.",
      "options": [
        [
          "A",
          "clean"
        ],
        [
          "B",
          "cleaned"
        ],
        [
          "C",
          "cleaning"
        ]
      ],
      "answer": "B",
      "rationale": "yesterday afternoon限定过去，cleaned合适；clean原形时态不合，cleaning缺助动词。"
    },
    {
      "number": 5,
      "stem": "Listen! Someone ____ at the door now.",
      "options": [
        [
          "A",
          "knocked"
        ],
        [
          "B",
          "knock"
        ],
        [
          "C",
          "is knocking"
        ]
      ],
      "answer": "C",
      "rationale": "Listen及now指当前正在敲门；someone单数用is knocking。A过去、B原形均不构成此时正在发生的谓语。"
    },
    {
      "number": 6,
      "stem": "This notebook belongs to Lucy. Please give it to ____.",
      "options": [
        [
          "A",
          "she"
        ],
        [
          "B",
          "hers"
        ],
        [
          "C",
          "her"
        ]
      ],
      "answer": "C",
      "rationale": "介词to后指Lucy用宾格her。she主格；hers为独立所属，不能在此指收件人Lucy本人。"
    },
    {
      "number": 7,
      "stem": "There is not ____ milk in the bottle. It is completely empty.",
      "options": [
        [
          "A",
          "any"
        ],
        [
          "B",
          "many"
        ],
        [
          "C",
          "a"
        ]

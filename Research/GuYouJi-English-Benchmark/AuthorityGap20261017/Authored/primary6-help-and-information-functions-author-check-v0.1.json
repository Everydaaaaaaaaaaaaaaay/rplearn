  "review_response_tasks": [
    {
      "number": 1,
      "stem": "你在图书馆找不到某本书，想请管理员帮忙找。你会说：",
      "options": [
        [
          "A",
          "Could you help me find this book, please?"
        ],
        [
          "B",
          "How old are you?"
        ],
        [
          "C",
          "I do not like this colour."
        ]
      ],
      "answer": "A",
      "rationale": "A向管理员请求找书，符合角色与目的；B问年龄，C评价颜色，均未请求找书。"
    },
    {
      "number": 2,
      "stem": "你是售货员，顾客问这支笔多少钱。价签写着5元。你会回答：",
      "options": [
        [
          "A",
          "It is on the desk."
        ],
        [
          "B",
          "It is five yuan."
        ],
        [
          "C",
          "There are five pens."
        ]
      ],
      "answer": "B",
      "rationale": "B给明示价格；A给位置，C给数量，即使同有five也不回答多少钱。"
    },
    {
      "number": 3,
      "stem": "朋友问你明天怎样去博物馆。你已决定乘公共汽车。你会回答：",
      "options": [
        [
          "A",
          "At nine o'clock."
        ],
        [
          "B",
          "To the museum."
        ],
        [
          "C",
          "By bus."
        ]
      ],
      "answer": "C",
      "rationale": "C给已设定交通方式；A钟点，B目的地都不回答怎样去。"
    },
    {
      "number": 4,
      "stem": "你不小心踩到同学的脚，需要为自己的行为道歉。你会说：",
      "options": [
        [
          "A",
          "I am sorry."
        ],
        [
          "B",
          "Thank you."
        ],
        [
          "C",
          "Happy birthday."
        ]
      ],
      "answer": "A",
      "rationale": "A为自己的踩脚行为道歉；B感谢，C生日祝福不表达道歉，避免源14.2致谢/回礼竞争。"
    },
    {
      "number": 5,
      "stem": "你是游客，想知道去火车站怎么走。你向路人问：",
      "options": [
        [
          "A",
          "When is your birthday?"
        ],
        [
          "B",
          "How can I get to the station?"
        ],
        [
          "C",
          "What is your favourite sport?"
        ]
      ],
      "answer": "B",
      "rationale": "B问去火车站的路线；A问生日、C问喜好，都不达问路目的。"
    }
  ],

  "review_response_tasks": [
    {
      "number": 1,
      "stem": "This bicycle is not yours or mine. It belongs to Ana, so it is ____.",
      "options": [
        [
          "A",
          "she"
        ],
        [
          "B",
          "herself"
        ],
        [
          "C",
          "her"
        ],
        [
          "D",
          "hers"
        ]
      ],
      "answer": "D",
      "rationale": "hers：hers独立表herbicycle；her需名词/she主格/herself反身不能替所有关系。"
    },
    {
      "number": 2,
      "stem": "The letters ____ by a volunteer yesterday.",
      "options": [
        [
          "A",
          "are delivering"
        ],
        [
          "B",
          "were delivered"
        ],
        [
          "C",
          "delivered"
        ],
        [
          "D",
          "has delivered"
        ]
      ],
      "answer": "B",
      "rationale": "were delivered：letters被递送且yesterday用weredelivered；delivered主动缺宾且方向反，aredelivering主动，hasdelivered数/方向错。"
    },
    {
      "number": 3,
      "stem": "I cannot enter the room because I ____ my key. I still have not found it.",
      "options": [
        [
          "A",
          "have lost"
        ],
        [
          "B",
          "will lose"
        ],
        [
          "C",
          "am losing"
        ],
        [
          "D",
          "lose"
        ]
      ],
      "answer": "A",
      "rationale": "have lost：已丢而结果持续havelost；willlose未来，amlosing进行失去，lose习惯均不合stillnotfound。"
    },
    {
      "number": 4,
      "stem": "The student ____ helped me carry the box is in Class 2.",
      "options": [
        [
          "A",
          "who"
        ],
        [
          "B",
          "what"
        ],
        [
          "C",
          "which"
        ],
        [
          "D",
          "whose"
        ]
      ],
      "answer": "A",
      "rationale": "who：student人先行词作helped主语who；which指物，whose需名词，what不能有此先行词。"
    },
    {
      "number": 5,
      "stem": "The soup is too hot ____ now. Let it cool for a minute.",
      "options": [
        [
          "A",
          "drinks"
        ],
        [
          "B",
          "to drink"
        ],
        [
          "C",
          "drank"
        ],
        [
          "D",
          "drink"
        ]
      ],
      "answer": "B",
      "rationale": "to drink：too...todo结构todrink；drink缺to，drank/drinks限定形式不合。"
    },
    {
      "number": 6,
      "stem": "Please tell me ____ the library closes. I need its closing time.",
      "options": [
        [
          "A",
          "when"
        ],
        [
          "B",
          "where"
        ],
        [
          "C",
          "whose"
        ],
        [
          "D",
          "who"
        ]
      ],
      "answer": "A",
      "rationale": "when：closingtime对应when；where地点/who人物/whose所属不答关门时。"
    },
    {
      "number": 7,
      "stem": "You should put the notice where it can be seen ____.",
      "options": [
        [
          "A",
          "clearly"
        ],
        [
          "B",
          "clear"
        ],
        [
          "C",
          "clearest"
        ],
        [
          "D",
          "clearness"
        ]
      ],
      "answer": "A",
      "rationale": "clearly：修饰seen用clearly副词；clear形容词、clearness名词、clearest最高形容词不作本方式状语。"
    },
    {
      "number": 8,
      "stem": "There is ____ water in the bottle, so we need to refill it before leaving. It is almost empty.",
      "options": [
        [
          "A",
          "a few"
        ],
        [
          "B",
          "little"
        ],
        [
          "C",
          "few"
        ],
        [
          "D",
          "many"
        ]
      ],
      "answer": "B",
      "rationale": "little：water不可数且almostempty用little；few/many/afew均修可数复数，不能修water。"
    },
    {
      "number": 9,
      "stem": "—Would you mind closing the window? —____. I feel cold too.",
      "options": [
        [
          "A",
          "Yes, please"
        ],
        [
          "B",
          "Not at all"
        ],
        [
          "C",
          "Never do that"
        ],
        [
          "D",
          "It is a window"
        ]
      ],
      "answer": "B",
      "rationale": "Not at all：Notatall同意请求并同冷；Yesplease通常应对提供，不答mind者同意，Never拒与同冷不合，Itwindow无关。"
    },
    {
      "number": 10,
      "stem": "By the time we reached the cinema, the film ____ already started.",
      "options": [
        [
          "A",
          "is"
        ],
        [
          "B",
          "had"
        ],
        [
          "C",
          "has"
        ],
        [
          "D",
          "will"
        ]
      ],
      "answer": "B",
      "rationale": "had：过去reach前已开始，hadstarted过去完成；has现在完成，will后应原形start，is不能配started表本不及物开始的时态。"
    }
  ],

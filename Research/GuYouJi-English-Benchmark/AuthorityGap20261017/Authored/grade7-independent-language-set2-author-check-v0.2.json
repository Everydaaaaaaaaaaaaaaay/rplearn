  "review_response_tasks": [
    {
      "number": 1,
      "stem": "This is my uncle. ____ works in a bookshop.",
      "options": [
        [
          "A",
          "His"
        ],
        [
          "B",
          "He"
        ],
        [
          "C",
          "Him"
        ]
      ],
      "answer": "B",
      "rationale": "He：主语位置用He；Him为宾格，His是物主形式，不能单独作此work的主语。"
    },
    {
      "number": 2,
      "stem": "We often skate ____ winter.",
      "options": [
        [
          "A",
          "on"
        ],
        [
          "B",
          "at"
        ],
        [
          "C",
          "in"
        ]
      ],
      "answer": "C",
      "rationale": "in：季节winter前用in；on用于具体日，at用于时点，不构成本句季节搭配。"
    },
    {
      "number": 3,
      "stem": "The bag is not black ____ brown.",
      "options": [
        [
          "A",
          "because"
        ],
        [
          "B",
          "but"
        ],
        [
          "C",
          "so"
        ]
      ],
      "answer": "B",
      "rationale": "but：not...but...并列black/brown，but表纠正；because/so不能连接这里两个并列颜色形容词。"
    },
    {
      "number": 4,
      "stem": "—How often do you water the plant? —____.",
      "options": [
        [
          "A",
          "My sister"
        ],
        [
          "B",
          "Every two days"
        ],
        [
          "C",
          "In the garden"
        ]
      ],
      "answer": "B",
      "rationale": "Every two days：Every two days答频率；In garden答地点，My sister答人物，不答how often。"
    },
    {
      "number": 5,
      "stem": "____ your parents work in this school?",
      "options": [
        [
          "A",
          "Do"
        ],
        [
          "B",
          "Does"
        ],
        [
          "C",
          "Is"
        ]
      ],
      "answer": "A",
      "rationale": "Do：parents复数且work实义动词，用Do；Does三单不符，Is不能接原形work作此一般问句。"
    },
    {
      "number": 6,
      "stem": "There ____ four chairs near the window.",
      "options": [
        [
          "A",
          "are"
        ],
        [
          "B",
          "has"
        ],
        [
          "C",
          "is"
        ]
      ],
      "answer": "A",
      "rationale": "are：复数fourchairs存在句are；is数不合，has不能作此therebe结构。"
    },
    {
      "number": 7,
      "stem": "—____ is the music room? —Next to the library.",
      "options": [
        [
          "A",
          "When"
        ],
        [
          "B",
          "Who"
        ],
        [
          "C",
          "Where"
        ]
      ],
      "answer": "C",
      "rationale": "Where：Nexttolibrary答位置，Where；When问时，Who问人。"
    },
    {
      "number": 8,
      "stem": "My brother ____ his bike to school every day.",
      "options": [
        [
          "A",
          "rides"
        ],
        [
          "B",
          "ride"
        ],
        [
          "C",
          "riding"
        ]
      ],
      "answer": "A",
      "rationale": "rides：everyday习惯、brother单数，rides；ride数不合，riding缺限定助动词。"
    },
    {
      "number": 9,
      "stem": "Look! The children ____ a snowman now.",
      "options": [
        [
          "A",
          "are making"
        ],
        [
          "B",
          "made"
        ],
        [
          "C",
          "makes"
        ]
      ],
      "answer": "A",
      "rationale": "are making：Look/now现场进行，children复数are making；makes三单数不合，made过去不合现场。"
    },
    {
      "number": 10,
      "stem": "Tomorrow we ____ visit our grandparents.",
      "options": [
        [
          "A",
          "is"
        ],
        [
          "B",
          "will"
        ],
        [
          "C",
          "are"
        ]
      ],
      "answer": "B",
      "rationale": "will：will后接visit原形组成将来；are/is不能直接接visit构成此谓语，is还与we不合。"
    }
  ],

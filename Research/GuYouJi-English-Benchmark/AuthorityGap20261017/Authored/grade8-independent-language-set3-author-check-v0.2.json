  "review_response_tasks": [
    {
      "number": 1,
      "stem": "The red gloves belong to us. They are ____.",
      "options": [
        [
          "A",
          "ours"
        ],
        [
          "B",
          "we"
        ],
        [
          "C",
          "us"
        ],
        [
          "D",
          "our"
        ]
      ],
      "answer": "A",
      "rationale": "ours：ours独立表ourgloves；our缺名词，we/us不表示物的归属。"
    },
    {
      "number": 2,
      "stem": "The bridge was repaired ____ 2018.",
      "options": [
        [
          "A",
          "in"
        ],
        [
          "B",
          "from"
        ],
        [
          "C",
          "on"
        ],
        [
          "D",
          "at"
        ]
      ],
      "answer": "A",
      "rationale": "in：年份in2018；at/on不合单年份，from起点后无持续终点不表达该年被修成事件。"
    },
    {
      "number": 3,
      "stem": "I stayed at home ____ I had a bad cold.",
      "options": [
        [
          "A",
          "so"
        ],
        [
          "B",
          "until"
        ],
        [
          "C",
          "or"
        ],
        [
          "D",
          "because"
        ]
      ],
      "answer": "D",
      "rationale": "because：感冒解释stayhome原因，because；so把后因改结果，or选择、until截止均不表达已给感冒理由。"
    },
    {
      "number": 4,
      "stem": "The path by the river is ____ than the road through the town.",
      "options": [
        [
          "A",
          "quietest"
        ],
        [
          "B",
          "quieter"
        ],
        [
          "C",
          "quiet"
        ],
        [
          "D",
          "quietly"
        ]
      ],
      "answer": "B",
      "rationale": "quieter：than比较级quieter；quiet原级，quietest最高，quietly副词不作is表语。"
    },
    {
      "number": 5,
      "stem": "Visitors ____ feed the animals. The sign says “No feeding”.",
      "options": [
        [
          "A",
          "must not"
        ],
        [
          "B",
          "need not"
        ],
        [
          "C",
          "do not have to"
        ],
        [
          "D",
          "may"
        ]
      ],
      "answer": "A",
      "rationale": "must not：明禁喂用mustnot；不必donthaveto/neednot不是禁止，may允许相反。"
    },
    {
      "number": 6,
      "stem": "—____ is it from the station to your home? —Two kilometres.",
      "options": [
        [
          "A",
          "How old"
        ],
        [
          "B",
          "How often"
        ],
        [
          "C",
          "How far"
        ],
        [
          "D",
          "How long"
        ]
      ],
      "answer": "C",
      "rationale": "How far：twokm距离far；old年龄/long时长/often频率均非距离。"
    },
    {
      "number": 7,
      "stem": "Our art lesson ____ at four every Tuesday.",
      "options": [
        [
          "A",
          "to begin"
        ],
        [
          "B",
          "begins"
        ],
        [
          "C",
          "begin"
        ],
        [
          "D",
          "beginning"
        ]
      ],
      "answer": "B",
      "rationale": "begins：lesson单数每周习惯begins；begin数错，beginning/tobegin非独立谓语。"
    },
    {
      "number": 8,
      "stem": "I ____ my key on the bus this morning, so I walked back to look for it.",
      "options": [
        [
          "A",
          "loses"
        ],
        [
          "B",
          "lost"
        ],
        [
          "C",
          "losing"
        ],
        [
          "D",
          "lose"
        ]
      ],
      "answer": "B",
      "rationale": "lost：后walked回找已发生，lost；lose/loses现在，losing非限定谓语。"
    },
    {
      "number": 9,
      "stem": "When I arrived, the students ____ a song. I listened until they finished.",
      "options": [
        [
          "A",
          "sing"
        ],
        [
          "B",
          "have sung"
        ],
        [
          "C",
          "were singing"
        ],
        [
          "D",
          "will sing"
        ]
      ],
      "answer": "C",
      "rationale": "were singing：arrived时正在唱接untilfinished，weresinging；sing一般现在，willsing未来，havesung现在完成非该过去进程。"
    },
    {
      "number": 10,
      "stem": "If the shop is open tomorrow, I ____ a new notebook.",
      "options": [
        [
          "A",
          "has bought"
        ],
        [
          "B",
          "buying"
        ],
        [
          "C",
          "bought"
        ],
        [
          "D",
          "will buy"
        ]
      ],
      "answer": "D",
      "rationale": "will buy：未来条件主句willbuy；bought过去，buying缺谓语，hasbought与I数不合。"
    },
    {
      "number": 11,
      "stem": "Of all the buildings in the town, this one is the ____.",
      "options": [
        [
          "A",
          "tallly"
        ],
        [
          "B",
          "taller"
        ],
        [
          "C",
          "tall"
        ],
        [
          "D",
          "tallest"
        ]
      ],
      "answer": "D",
      "rationale": "tallest：ofall与the后最高级tallest；taller比较非全体最高，tall不能单独在the后作此最高级表语，tallly不是正确词。"
    },
    {
      "number": 12,
      "stem": "They decided ____ the broken gate before winter.",
      "options": [
        [
          "A",
          "repaired"
        ],
        [
          "B",
          "repairing"
        ],
        [
          "C",
          "to repair"
        ],
        [
          "D",
          "repair"
        ]
      ],
      "answer": "C",
      "rationale": "to repair：decideto do；repair缺to，repaired/repairing非本decide补语。"
    }

  "review_response_tasks": [
    {
      "number": 1,
      "stem": "The box was ____ during transport, so the shop sent a replacement.",
      "options": [
        [
          "A",
          "persuaded"
        ],
        [
          "B",
          "damaged"
        ],
        [
          "C",
          "nominated"
        ],
        [
          "D",
          "translated"
        ]
      ],
      "answer": "B",
      "rationale": "damaged：damaged损坏导致replacement；nominated提名/translated翻译/persuaded说服非盒子运输损坏。"
    },
    {
      "number": 2,
      "stem": "Please make the instructions ____: name the exact button and say when to press it.",
      "options": [
        [
          "A",
          "specific"
        ],
        [
          "B",
          "vague"
        ],
        [
          "C",
          "permanent"
        ],
        [
          "D",
          "silent"
        ]
      ],
      "answer": "A",
      "rationale": "specific：exactbutton/when具体specific；vague模糊反，permanent时间/silent声音非明确程度。"
    },
    {
      "number": 3,
      "stem": "The offer is “optional”, so taking part is ____.",
      "options": [
        [
          "A",
          "a requirement"
        ],
        [
          "B",
          "a penalty"
        ],
        [
          "C",
          "a certainty"
        ],
        [
          "D",
          "a choice"
        ]
      ],
      "answer": "D",
      "rationale": "a choice：optional可选择=achoice；requirement必须相反，penalty惩罚/certainty必然不合非必。"
    },
    {
      "number": 4,
      "stem": "The committee will ____ the final decision until the missing information arrives.",
      "options": [
        [
          "A",
          "consume"
        ],
        [
          "B",
          "decorate"
        ],
        [
          "C",
          "postpone"
        ],
        [
          "D",
          "imitate"
        ]
      ],
      "answer": "C",
      "rationale": "postpone：untilinfoarrives延后postpone；imitate模仿/consume消耗/decorate装饰不表延迟决策。"
    },
    {
      "number": 5,
      "stem": "The guide prevented us ____ entering the closed room.",
      "options": [
        [
          "A",
          "at"
        ],
        [
          "B",
          "from"
        ],
        [
          "C",
          "to"
        ],
        [
          "D",
          "of"
        ]
      ],
      "answer": "B",
      "rationale": "from：preventsbfromdoing；to/of/at不构成该阻止结构。"
    },
    {
      "number": 6,
      "stem": "The museum, ____ roof was repaired last year, is open again.",
      "options": [
        [
          "A",
          "whose"
        ],
        [
          "B",
          "who"
        ],
        [
          "C",
          "whom"
        ],
        [
          "D",
          "where"
        ]
      ],
      "answer": "A",
      "rationale": "whose：roof前需物的所属whose；who/whom指人不修roof，where地点状语也不能直接修名词roof。"
    },
    {
      "number": 7,
      "stem": "____ by the sudden noise, the cat ran under the sofa.",
      "options": [
        [
          "A",
          "Frightening"
        ],
        [
          "B",
          "To frighten"
        ],
        [
          "C",
          "Frightens"
        ],
        [
          "D",
          "Frightened"
        ]
      ],
      "answer": "D",
      "rationale": "Frightened：cat受到惊吓Frightened；Frightening主动吓别人非句意，Tofrighten表目的不表已受惊，Frightens限定不作状语。"
    },
    {
      "number": 8,
      "stem": "We found the gate locked. The caretaker ____ already gone home.",
      "options": [
        [
          "A",
          "will"
        ],
        [
          "B",
          "are"
        ],
        [
          "C",
          "had"
        ],
        [
          "D",
          "has"
        ]
      ],
      "answer": "C",
      "rationale": "had：过去found时已返hadgone；has现在基点不合该叙时，will后gone错，are主语单数且不能作gonehome过去完成。"
    },
    {
      "number": 9,
      "stem": "____ matters most is whether the instructions can be followed.",
      "options": [
        [
          "A",
          "Whom"
        ],
        [
          "B",
          "What"
        ],
        [
          "C",
          "Whether"
        ],
        [
          "D",
          "That"
        ]
      ],
      "answer": "B",
      "rationale": "What：What既连接主语句又作matters主语；Whether/That不填句内主语缺，Whom宾格不作matters主语。"
    },
    {
      "number": 10,
      "stem": "We have not decided ____ to hold the meeting indoors or outside.",
      "options": [
        [
          "A",
          "whether"
        ],
        [
          "B",
          "what"
        ],
        [
          "C",
          "whose"
        ],
        [
          "D",
          "whom"
        ]
      ],
      "answer": "A",
      "rationale": "whether：whether to...or...表示选择；what需宾语角色而hold已有meeting，whose/whom不引此二选。"
    },
    {
      "number": 11,
      "stem": "The vase broke. If I had carried it more carefully, I ____ dropped it.",
      "options": [
        [
          "A",
          "will not"
        ],
        [
          "B",
          "am not"
        ],
        [
          "C",
          "does not"
        ],
        [
          "D",
          "would not have"
        ]
      ],
      "answer": "D",
      "rationale": "would not have：过去破了反事实wouldnothavedropped；willnot后dropped错，amnot被掉落施受不合，doesnot后原形且数人称不符。"
    },
    {
      "number": 12,
      "stem": "By this time tomorrow, I ____ finished the translation.",
      "options": [
        [
          "A",
          "was"
        ],
        [
          "B",
          "are"
        ],
        [
          "C",
          "will have"
        ],
        [
          "D",
          "will"
        ]
      ],
      "answer": "C",
      "rationale": "will have：future完成willhavefinished；will缺have，was/arefinished被动不表达I主动完译且are数错。"
    },
    {
      "number": 13,
      "stem": "She left without ____ her name.",
      "options": [
        [
          "A",
          "give"
        ],
        [
          "B",
          "giving"
        ],
        [
          "C",
          "gave"
        ],
        [
          "D",
          "gives"
        ]
      ],
      "answer": "B",
      "rationale": "giving：without介词后giving；gave/gives限定不作介词宾语，give原形不合。"
    },
    {
      "number": 14,
      "stem": "To our ____, the missing pages were found in the back of the folder.",
      "options": [
        [
          "A",
          "relief"
        ],
        [
          "B",
          "relieved"
        ],
        [
          "C",
          "relieve"
        ],
        [
          "D",
          "relievingly"
        ]
      ],
      "answer": "A",
      "rationale": "relief：toonesrelief名词宽慰；relieved形容词，relieve动词，relievingly非此名词位。"
    },
    {
      "number": 15,
      "stem": "He wanted to know where ____ the previous evening.",
      "options": [
        [
          "A",
          "had we stayed"
        ],
        [
          "B",
          "did we stay"
        ],
        [
          "C",
          "we have staying"
        ],
        [

  "review_response_tasks": [
    {
      "number": 1,
      "stem": "The witness could not ____ the driver because it was dark and she had not seen his face.",
      "options": [
        [
          "A",
          "appoint"
        ],
        [
          "B",
          "identify"
        ],
        [
          "C",
          "borrow"
        ],
        [
          "D",
          "consume"
        ]
      ],
      "answer": "B",
      "rationale": "identify：identify辨认人对应未见face；appoint任命/consume消耗/borrow借不表辨身份。"
    },
    {
      "number": 2,
      "stem": "The concert was cancelled ____ because the roof was unsafe, not because ticket sales were low.",
      "options": [
        [
          "A",
          "for safety reasons"
        ],
        [
          "B",
          "on sale"
        ],
        [
          "C",
          "by coincidence"
        ],
        [
          "D",
          "in silence"
        ]
      ],
      "answer": "A",
      "rationale": "for safety reasons：明确unsafe roof原因for safetyreasons；coincidence巧合与原因不合，onsale出售，insilence方式不解取消缘由。"
    },
    {
      "number": 3,
      "stem": "After waiting all morning, she finally ____ when her name was called. She had to stand to receive the award.",
      "options": [
        [
          "A",
          "lost her temper"
        ],
        [
          "B",
          "kept her distance"
        ],
        [
          "C",
          "turned a blind eye"
        ],
        [
          "D",
          "rose to her feet"
        ]
      ],
      "answer": "D",
      "rationale": "rose to her feet：stand领奖对应rosefeet；发脾气/保持距离/视而不见无该起立动作。"
    },
    {
      "number": 4,
      "stem": "The shop agreed to ____ the damaged item with a new one at no extra cost.",
      "options": [
        [
          "A",
          "resist"
        ],
        [
          "B",
          "predict"
        ],
        [
          "C",
          "replace"
        ],
        [
          "D",
          "deserve"
        ]
      ],
      "answer": "C",
      "rationale": "replace：replaceAwithB以新换坏；predict预测/resist抵抗/deserve应得不构成该替换。"
    },
    {
      "number": 5,
      "stem": "The curtains are ____, so people outside cannot see through them.",
      "options": [
        [
          "A",
          "opaque"
        ],
        [
          "B",
          "edible"
        ],
        [
          "C",
          "portable"
        ],
        [
          "D",
          "transparent"
        ]
      ],
      "answer": "A",
      "rationale": "opaque：opaque不透；transparent透明相反，portable可携/edible可食不解释看不穿。"
    },
    {
      "number": 6,
      "stem": "A gentle ____ moved the leaves, but the air was not strong enough to disturb the papers.",
      "options": [
        [
          "A",
          "flood"
        ],
        [
          "B",
          "hurricane"
        ],
        [
          "C",
          "earthquake"
        ],
        [
          "D",
          "breeze"
        ]
      ],
      "answer": "D",
      "rationale": "breeze：gentle轻风breeze；hurricane强风与gentle反，earthquake/flood不是此温和气流。"
    },
    {
      "number": 7,
      "stem": "The group hopes to ____ awareness of the local collection by holding an open evening.",
      "options": [
        [
          "A",
          "raise"
        ],
        [
          "B",
          "hide"
        ],
        [
          "C",
          "spend"
        ],
        [
          "D",
          "owe"
        ]
      ],
      "answer": "A",
      "rationale": "raise：raiseawareness提升认知固定搭配；owe欠/hide隐蔽/spend花费不能表达该宣传意图。"
    },
    {
      "number": 8,
      "stem": "The note says the delay is “brief”. Here “brief” means ____.",
      "options": [
        [
          "A",
          "permanent"
        ],
        [
          "B",
          "short"
        ],
        [
          "C",
          "frequent"
        ],
        [
          "D",
          "dangerous"
        ]
      ],
      "answer": "B",
      "rationale": "short：brief短暂short；permanent永久相反，frequent频次，dangerous危险非时长。"
    },
    {
      "number": 9,
      "stem": "The cover is designed to ____ the screen from scratches during transport.",
      "options": [
        [
          "A",
          "imitate"
        ],
        [
          "B",
          "accuse"
        ],
        [
          "C",
          "threaten"
        ],
        [
          "D",
          "protect"
        ]
      ],
      "answer": "D",
      "rationale": "protect：protectfrom保护免刮；accuse控告/threaten威胁/imitate模仿不表保护。"
    },
    {
      "number": 10,
      "stem": "To ____ unnecessary packaging, customers can bring their own containers.",
      "options": [
        [
          "A",
          "reduce"
        ],
        [
          "B",
          "overlook"
        ],
        [
          "C",
          "generate"
        ],
        [
          "D",
          "expand"
        ]
      ],
      "answer": "A",
      "rationale": "reduce：自带容器减少包装reduce；generate生成/expand扩大反，overlook忽略不等减少量。"
    },
    {
      "number": 11,
      "stem": "In the 1990 story, Jo left home not knowing that she ____ return for ten years.",
      "options": [
        [
          "A",
          "is not"
        ],
        [
          "B",
          "had not"
        ],
        [
          "C",
          "has not"
        ],
        [
          "D",
          "would not"
        ]
      ],
      "answer": "D",
      "rationale": "would not：过去视角未发生未来10年，wouldnotreturn；hasnot/hadnot需returned非return，isnot接return不合。"
    },
    {
      "number": 12,
      "stem": "The club provides a setting ____ newcomers can ask basic questions without feeling foolish.",
      "options": [
        [
          "A",
          "when"
        ],
        [
          "B",
          "where"
        ],
        [
          "C",
          "which"
        ],
        [
          "D",
          "whose"
        ]
      ],
      "answer": "B",
      "rationale": "where：setting作场景从句不缺主宾需where；which缺介词不充场所，whose需名词，when时间非setting地点。"
    },
    {
      "number": 13,
      "stem": "The lamp ____ above the door ____ the entrance at night.",

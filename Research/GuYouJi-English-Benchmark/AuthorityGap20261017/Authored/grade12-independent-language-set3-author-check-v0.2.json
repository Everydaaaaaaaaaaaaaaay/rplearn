  "review_response_tasks": [
    {
      "number": 1,
      "stem": "The statement was ____ because it applied the result to every visitor, although only one small group had been studied.",
      "options": [
        [
          "A",
          "portable"
        ],
        [
          "B",
          "reversible"
        ],
        [
          "C",
          "edible"
        ],
        [
          "D",
          "misleading"
        ]
      ],
      "answer": "D",
      "rationale": "misleading：小样本外推所有游客使misleading误导；edible可食/portable可携/reversible可逆不说明该范围错误。"
    },
    {
      "number": 2,
      "stem": "The changes were ____: the original layout could be restored without replacing any parts.",
      "options": [
        [
          "A",
          "inevitable"
        ],
        [
          "B",
          "opaque"
        ],
        [
          "C",
          "permanent"
        ],
        [
          "D",
          "reversible"
        ]
      ],
      "answer": "D",
      "rationale": "reversible：可还原= reversible；permanent永久反，inevitable必然/opaque不透非能恢复。"
    },
    {
      "number": 3,
      "stem": "Please ____ the source of each quotation rather than leaving readers to guess who said it.",
      "options": [
        [
          "A",
          "identify"
        ],
        [
          "B",
          "appoint"
        ],
        [
          "C",
          "owe"
        ],
        [
          "D",
          "consume"
        ]
      ],
      "answer": "A",
      "rationale": "identify：identify辨明引语来源，猜who正需归属；consume消耗/appoint任命/owe欠不表示来源标明。"
    },
    {
      "number": 4,
      "stem": "The team rejected the claim because the evidence was ____. It did not establish the proposed link.",
      "options": [
        [
          "A",
          "transparent"
        ],
        [
          "B",
          "insufficient"
        ],
        [
          "C",
          "temporary"
        ],
        [
          "D",
          "portable"
        ]
      ],
      "answer": "B",
      "rationale": "insufficient：不能建立link证据不足insufficient；transparent透明/portable可携/temporary暂时不等充分性不足。"
    },
    {
      "number": 5,
      "stem": "The decision should be based ____ the information actually available.",
      "options": [
        [
          "A",
          "for"
        ],
        [
          "B",
          "on"
        ],
        [
          "C",
          "of"
        ],
        [
          "D",
          "at"
        ]
      ],
      "answer": "B",
      "rationale": "on：basedon根据；at/for/of不构成本被动搭配。"
    },
    {
      "number": 6,
      "stem": "Only when the meeting ended ____ we realise that the final page was missing.",
      "options": [
        [
          "A",
          "was"
        ],
        [
          "B",
          "has"
        ],
        [
          "C",
          "is"
        ],
        [
          "D",
          "did"
        ]
      ],
      "answer": "D",
      "rationale": "did：Onlywhen前置过去ended须did+realise；has后realised且we数不符，is/was后不接realise原形作该倒装。"
    },
    {
      "number": 7,
      "stem": "Had she taken the earlier bus, she ____ arrived before the doors closed.",
      "options": [
        [
          "A",
          "is"
        ],
        [
          "B",
          "would have"
        ],
        [
          "C",
          "does"
        ],
        [
          "D",
          "will have"
        ]
      ],
      "answer": "B",
      "rationale": "would have：Had过去反事实配wouldhavearrived；will未来完成错基点，is/does不接arrived表达此假设。"
    },
    {
      "number": 8,
      "stem": "The applicants, ____ names appear below, should check the final schedule.",
      "options": [
        [
          "A",
          "whom"
        ],
        [
          "B",
          "whose"
        ],
        [
          "C",
          "who"
        ],
        [
          "D",
          "which"
        ]
      ],
      "answer": "B",
      "rationale": "whose：names前所属whose；who/whom不直接修名词，which为物选择不表达applicants所属。"
    },
    {
      "number": 9,
      "stem": "The committee recommended that the rule ____ reviewed every year.",
      "options": [
        [
          "A",
          "being"
        ],
        [
          "B",
          "been"
        ],
        [
          "C",
          "be"
        ],
        [
          "D",
          "to be"
        ]
      ],
      "answer": "C",
      "rationale": "be：建议虚拟be reviewed完成that谓语；being/been分词非限定，tobe不定式不能独立作此that从句谓语。"
    },
    {
      "number": 10,
      "stem": "Hardly had we begun the rehearsal ____ the lights went out.",
      "options": [
        [
          "A",
          "when"
        ],
        [
          "B",
          "that"
        ],
        [
          "C",
          "than"
        ],
        [
          "D",
          "as"
        ]
      ],
      "answer": "A",
      "rationale": "when：hardly...when关联；than搭nosooner，that/as非该固定结构。"
    },
    {
      "number": 11,
      "stem": "The problem lies not in the number of records ____ in how they are selected.",
      "options": [
        [
          "A",
          "because"
        ],
        [
          "B",
          "but"
        ],
        [
          "C",
          "unless"
        ],
        [
          "D",
          "so"
        ]
      ],
      "answer": "B",
      "rationale": "but：notin...butin...对照选取方式，but；其余不能并列两个in短语表达该纠正。"
    },
    {
      "number": 12,
      "stem": "The manuscript is thought ____ in the previous century.",
      "options": [
        [
          "A",
          "to writing"
        ],
        [
          "B",
          "being write"
        ],
        [
          "C",
          "to have been written"
        ],
        [
          "D",
          "have wrote"
        ]
      ],
      "answer": "C",
      "rationale": "to have been written：isthoughtto、过去被写tohavebeenwritten；towriting错，havewrote非正确完成且缺to，beingwrite错。"
    },
    {
      "number": 13,
      "stem": "____ the earlier version, the editor could explain exactly what had changed.",
      "options": [
        [
          "A",
          "Reads"
        ],
        [
          "B",
          "Read"
        ],
        [
          "C",
          "To reading"
        ],
        [
          "D",
          "Having read"
        ]
      ],
      "answer": "D",
      "rationale": "Having read：editor主动先read用Havingread；Read被动不合施受，Toreading错，Reads限定不作该状语。"
    },
    {
      "number": 14,
      "stem": "The purpose is to describe the alternatives, ____ to choose on the reader’s behalf.",
      "options": [
        [
          "A",
          "none"
        ],
        [
          "B",
          "nothing"
        ],
        [
          "C",
          "not"
        ],
        [
          "D",
          "no"
        ]
      ],
      "answer": "C",
      "rationale": "not：not否定并列tochoose与describe对照；no/none/nothing不能在此作不定式否定副词。"
    },
    {
      "number": 15,
      "stem": "I would rather they ____ the details before making a public announcement next week.",
      "options": [
        [
          "A",
          "checked"
        ],
        [
          "B",
          "checking"
        ],
        [
          "C",
          "will check"
        ],
        [
          "D",
          "check"
        ]
      ],
      "answer": "A",
      "rationale": "checked：wouldratherthey对未来意愿用checked；check现在式非该虚拟结构，willcheck不用于此愿望，checking缺限定。"
    }

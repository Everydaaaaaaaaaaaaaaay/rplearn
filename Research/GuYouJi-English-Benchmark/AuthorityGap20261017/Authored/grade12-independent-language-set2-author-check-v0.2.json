  "review_response_tasks": [
    {
      "number": 1,
      "stem": "The witness gave an ____ account, admitting where her memory was uncertain instead of inventing details.",
      "options": [
        [
          "A",
          "opaque"
        ],
        [
          "B",
          "honest"
        ],
        [
          "C",
          "accidental"
        ],
        [
          "D",
          "edible"
        ]
      ],
      "answer": "B",
      "rationale": "honest：承认不确定不编造=honest诚实；opaque不透/accidental偶然/edible可食不描述该诚实叙述。"
    },
    {
      "number": 2,
      "stem": "The apparent improvement was ____: it disappeared when the original conditions returned.",
      "options": [
        [
          "A",
          "permanent"
        ],
        [
          "B",
          "temporary"
        ],
        [
          "C",
          "inevitable"
        ],
        [
          "D",
          "identical"
        ]
      ],
      "answer": "B",
      "rationale": "temporary：条件恢复就消失，temporary暂时；permanent永久反，inevitable不可避/identical相同不表持续短。"
    },
    {
      "number": 3,
      "stem": "The editor asked the writer to ____ between a personal opinion and a claim supported by records.",
      "options": [
        [
          "A",
          "distinguish"
        ],
        [
          "B",
          "consume"
        ],
        [
          "C",
          "appoint"
        ],
        [
          "D",
          "borrow"
        ]
      ],
      "answer": "A",
      "rationale": "distinguish：distinguishbetween区分；consume消耗/appoint任命/borrow借不构成区分两类。"
    },
    {
      "number": 4,
      "stem": "He tried to ____ responsibility by blaming a colleague, although the records showed that he alone had caused the error.",
      "options": [
        [
          "A",
          "evade"
        ],
        [
          "B",
          "transport"
        ],
        [
          "C",
          "decorate"
        ],
        [
          "D",
          "calculate"
        ]
      ],
      "answer": "A",
      "rationale": "evade：将自己的错误推给同事是evade responsibility逃避责任；calculate计算、transport运输、decorate装饰均不表达推责，且与抽象responsibility不构成此行为搭配。"
    },
    {
      "number": 5,
      "stem": "The new finding is consistent ____ the earlier observations.",
      "options": [
        [
          "A",
          "for"
        ],
        [
          "B",
          "to"
        ],
        [
          "C",
          "at"
        ],
        [
          "D",
          "with"
        ]
      ],
      "answer": "D",
      "rationale": "with：consistentwith一致；to/at/for不构成本搭配。"
    },
    {
      "number": 6,
      "stem": "Only after the final check yesterday ____ the technician release the equipment.",
      "options": [
        [
          "A",
          "did"
        ],
        [
          "B",
          "does"
        ],
        [
          "C",
          "has"
        ],
        [
          "D",
          "is"
        ]
      ],
      "answer": "A",
      "rationale": "did：Onlyafter前置且yesterday明过去，did+release；does现在不合，has后应released，is不接release原形构成此倒装。"
    },
    {
      "number": 7,
      "stem": "Had we checked the address, we ____ sent the parcel to the wrong building.",
      "options": [
        [
          "A",
          "will not have"
        ],
        [
          "B",
          "would not have"
        ],
        [
          "C",
          "are not"
        ],
        [
          "D",
          "do not"
        ]
      ],
      "answer": "B",
      "rationale": "would not have：Hadwechecked过去反事实，wouldnothavesent；will未来完成不合，arenot/do not不接sent此过去反事实。"
    },
    {
      "number": 8,
      "stem": "The report, ____ was published yesterday, includes all the revised figures.",
      "options": [
        [
          "A",
          "that"
        ],
        [
          "B",
          "who"
        ],
        [
          "C",
          "which"
        ],
        [
          "D",
          "what"
        ]
      ],
      "answer": "C",
      "rationale": "which：非限制从句指report物作主语which；that不能此非限，what不能有先行词，who人。"
    },
    {
      "number": 9,
      "stem": "It is essential that every form ____ signed before submission.",
      "options": [
        [
          "A",
          "been"
        ],
        [
          "B",
          "being"
        ],
        [
          "C",
          "to be"
        ],
        [
          "D",
          "be"
        ]
      ],
      "answer": "D",
      "rationale": "be：that从句必须有谓语，此虚拟要求be signed；being/been非限定，tobe不能独立作that从句限定谓语。"
    },
    {
      "number": 10,
      "stem": "No sooner had the talk ended ____ questions began.",
      "options": [
        [
          "A",
          "than"
        ],
        [
          "B",
          "as"
        ],
        [
          "C",
          "that"
        ],
        [
          "D",
          "when"
        ]
      ],
      "answer": "A",
      "rationale": "than：nosooner...than固定；when用于hardly/scarcely搭配，that/as不构成该关联。"
    },
    {
      "number": 11,
      "stem": "The two proposals differ not in cost ____ in the amount of time required.",
      "options": [
        [
          "A",
          "so"
        ],
        [
          "B",
          "but"
        ],
        [
          "C",
          "because"
        ],
        [
          "D",
          "unless"
        ]
      ],
      "answer": "B",
      "rationale": "but：notin...butin...并列纠正，but；so/because/unless不能连接两个in介词短语作该对照。"
    },
    {
      "number": 12,
      "stem": "The chair is believed ____ over a century ago.",
      "options": [
        [
          "A",
          "being make"
        ],
        [
          "B",
          "have made"
        ],
        [
          "C",
          "to have been made"
        ],
        [
          "D",
          "to making"
        ]
      ],
      "answer": "C",
      "rationale": "to have been made：isbelievedto且过去已被制造tohavebeenmade；tomaking错，havemade缺to且主动，beingmake错。"
    },
    {
      "number": 13,
      "stem": "____ all the evidence, the panel postponed its judgement rather than announcing a conclusion that afternoon.",
      "options": [
        [
          "A",
          "Having considered"
        ],
        [
          "B",
          "Considers"
        ],
        [
          "C",
          "To considering"
        ],
        [
          "D",
          "Considered"
        ]
      ],
      "answer": "A",
      "rationale": "Having considered：panel主动先考虑证据Havingconsidered；Considered被动与panel施受反，Toconsidering错，Considers限定不能作该状语。"
    },
    {
      "number": 14,
      "stem": "The aim is to make the process transparent, ____ to guarantee that everyone will agree with the result.",
      "options": [
        [
          "A",
          "nothing"
        ],
        [
          "B",
          "not"
        ],
        [
          "C",
          "no"
        ],
        [
          "D",
          "none"
        ]
      ],
      "answer": "B",
      "rationale": "not：并列不定式对照notto guarantee；no/none/nothing不能直接否定此to不定式功能。"
    },
    {
      "number": 15,
      "stem": "I would rather you ____ the draft with me before sending it tomorrow.",
      "options": [
        [
          "A",
          "discussing"
        ],
        [
          "B",
          "will discuss"
        ],
        [
          "C",
          "discussed"
        ],
        [
          "D",
          "discuss"
        ]
      ],
      "answer": "C",
      "rationale": "discussed：wouldrathersb对未来愿望从句用过去式discussed；discuss非该时态形式，willdiscuss不合该虚拟愿望，discussing缺谓语。"
    }

      ],
      "answer": "A",
      "rationale": "restrict：无钥锁限制restrict；encourage鼓励相反，celebrate庆/imitate仿不表控制进入。"
    },
    {
      "number": 10,
      "stem": "The volunteers sorted the reusable paper to ____ it from ordinary rubbish.",
      "options": [
        [
          "A",
          "accuse"
        ],
        [
          "B",
          "borrow"
        ],
        [
          "C",
          "separate"

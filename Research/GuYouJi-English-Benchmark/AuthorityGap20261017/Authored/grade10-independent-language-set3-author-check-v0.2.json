  "review_response_tasks": [
    {
      "number": 1,
      "stem": "The manager asked the witness to ____ the colour and model of the car, not guess who owned it.",
      "options": [
        [
          "A",
          "forgive"
        ],
        [
          "B",
          "purchase"
        ],
        [
          "C",
          "consume"
        ],
        [
          "D",
          "describe"
        ]
      ],
      "answer": "D",
      "rationale": "describe：描述colour/model用describe；consume消耗/purchase买/forgive原谅不承该信息要求。"
    },
    {
      "number": 2,
      "stem": "The two neighbours met at the station ____; neither knew the other was travelling that day.",
      "options": [
        [
          "A",
          "by chance"
        ],
        [
          "B",
          "in charge"
        ],
        [
          "C",
          "at risk"
        ],
        [
          "D",
          "on purpose"
        ]
      ],
      "answer": "A",
      "rationale": "by chance：双方未知出行偶遇bychance；onpurpose故意反，incharge负责/atrisk危险无对应偶遇方式。"
    },
    {
      "number": 3,
      "stem": "Instead of shouting, he walked outside to ____ and returned when he felt calm.",
      "options": [
        [
          "A",
          "break down the door"
        ],
        [
          "B",
          "show off"
        ],
        [
          "C",
          "cool down"
        ],
        [
          "D",
          "give away the prize"
        ]
      ],
      "answer": "C",
      "rationale": "cool down：冷静后返cooldown；炫耀/破门/赠奖不说明平复情绪。"
    },
    {
      "number": 4,
      "stem": "The tutor encouraged us to ____ our answers against the text before handing them in.",
      "options": [
        [
          "A",
          "invent"
        ],
        [
          "B",
          "ignore"
        ],
        [
          "C",
          "check"
        ],
        [
          "D",
          "owe"
        ]
      ],
      "answer": "C",
      "rationale": "check：againsttext核答案check；invent编造/ignore无视反，owe欠不构成核对。"
    },
    {
      "number": 5,
      "stem": "The portable lamp is easy to carry. “Portable” means ____.",
      "options": [
        [
          "A",
          "movable"
        ],
        [
          "B",
          "fragile"
        ],
        [
          "C",
          "invisible"
        ],
        [
          "D",
          "permanent"
        ]
      ],
      "answer": "A",
      "rationale": "movable：portable可携movable；invisible不可见/permanent永久/fragile易碎不是携带属性同义。"
    },
    {
      "number": 6,
      "stem": "The warm afternoon ended with a short ____ of rain, not a long storm.",
      "options": [
        [
          "A",
          "shower"
        ],
        [
          "B",
          "landscape"
        ],
        [
          "C",
          "drought"
        ],
        [
          "D",
          "horizon"
        ]
      ],
      "answer": "A",
      "rationale": "shower：短阵雨shower；drought干旱反，landscape景/horizon地平线不是降水事件。"
    },
    {
      "number": 7,
      "stem": "The appeal asked residents to ____ books they no longer needed to the free reading room.",
      "options": [
        [
          "A",
          "donate"
        ],
        [
          "B",
          "consume"
        ],
        [
          "C",
          "owe"
        ],
        [
          "D",
          "forbid"
        ]
      ],
      "answer": "A",
      "rationale": "donate：将不用书捐免费阅览donate；consume消耗/forbid禁止/owe欠不表无偿给。"
    },
    {
      "number": 8,
      "stem": "The report calls the change “minor”, meaning it is ____.",
      "options": [
        [
          "A",
          "small"
        ],
        [
          "B",
          "permanent"
        ],
        [
          "C",
          "enormous"
        ],
        [
          "D",
          "inevitable"
        ]
      ],
      "answer": "A",
      "rationale": "small：minor小small；enormous巨大反，permanent持续/inevitable必然不是程度同义。"
    },
    {
      "number": 9,
      "stem": "The new lock will ____ access by people without the correct key.",
      "options": [
        [
          "A",
          "restrict"
        ],
        [
          "B",
          "imitate"
        ],
        [
          "C",
          "encourage"
        ],
        [
          "D",

  "review_response_tasks": [
    {
      "number": 1,
      "stem": "你想借同桌的橡皮擦一会儿，先征求许可。你会说：",
      "options": [
        [
          "A",
          "Where is my school?"
        ],
        [
          "B",
          "I have two erasers."
        ],
        [
          "C",
          "May I use your eraser, please?"
        ]
      ],
      "answer": "C",
      "rationale": "C针对对方橡皮提出借用请求；A问学校位置，B陈述自有物，没有征求借用许可。"
    },
    {
      "number": 2,
      "stem": "老师问谁今天值日。你知道是自己，想明确回答“我今天值日”。你会说：",
      "options": [
        [
          "A",
          "I am on duty today."
        ],
        [
          "B",
          "It is sunny today."
        ],
        [
          "C",
          "Today is Tuesday."
        ]
      ],
      "answer": "A",
      "rationale": "A明确自己值日；B天气、C星期虽含today相关信息，却不回应谁值日。"
    },
    {
      "number": 3,
      "stem": "你是服务员，客人已经点好一碗面，现在你只想问他还要不要喝点东西。你会说：",
      "options": [
        [
          "A",
          "How do you go to school?"
        ],
        [
          "B",
          "Would you like something to drink?"
        ],
        [
          "C",
          "What did you do yesterday?"
        ]
      ],
      "answer": "B",
      "rationale": "B在已点餐角色下询问饮品；A通学方式、C昨天活动均不询问饮料，角色不混同客人。"
    },
    {
      "number": 4,
      "stem": "朋友问你上周末做了什么。你想回答“我和爷爷种了树”。你会说：",
      "options": [
        [
          "A",
          "I will plant trees next week."
        ],
        [
          "B",
          "I am reading with Grandma."
        ],
        [
          "C",
          "I planted trees with Grandpa."
        ]
      ],
      "answer": "C",
      "rationale": "C在过去时给出设定的活动和同伴；A下周计划，B正在读书且同伴变为Grandma，均与信息不符。"
    },
    {
      "number": 5,
      "stem": "你是新转来的学生，想请同学告诉你他的名字。你会问：",
      "options": [
        [
          "A",
          "What is your name?"
        ],
        [
          "B",
          "What colour is your bag?"
        ],
        [
          "C",
          "How many books have you got?"
        ]
      ],
      "answer": "A",
      "rationale": "A问姓名；B颜色、C书的数量不问人物名字，避免源爱好三种问法的功能交叠。"
    }
  ],

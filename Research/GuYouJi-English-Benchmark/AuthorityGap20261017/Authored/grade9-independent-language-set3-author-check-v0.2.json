    {
      "number": 1,
      "stem": "Our classroom is larger than ____. Their class has fewer pupils.",
      "options": [
        [
          "A",
          "their"
        ],
        [
          "B",
          "theirs"
        ],
        [
          "C",
          "they"
        ],
        [
          "D",
          "them"
        ]
      ],
      "answer": "B",
      "rationale": "theirs：比较同类classroom用theirs；their缺名词，they/them为人不表教室。"
    },
    {
      "number": 2,
      "stem": "The new signs ____ next week, according to the plan.",
      "options": [
        [
          "A",
          "have installing"
        ],
        [
          "B",
          "installed"
        ],
        [
          "C",
          "will install"
        ],
        [
          "D",
          "will be installed"
        ]
      ],
      "answer": "D",
      "rationale": "will be installed：signs被装且nextweek将来被动；installed缺限定，haveinstalling错，willinstall主动方向不合。"
    },
    {
      "number": 3,
      "stem": "Mum is not here. She ____ to the market and will return soon.",
      "options": [
        [
          "A",
          "has gone"
        ],
        [
          "B",
          "goes"
        ],
        [
          "C",
          "has been"
        ],
        [
          "D",
          "going"
        ]
      ],
      "answer": "A",
      "rationale": "has gone：已去未回hasgone；hasbeen表示去过已返，不合nothere/willreturn，goes习惯，going缺谓语。"
    },
    {
      "number": 4,
      "stem": "I found the book ____ you left on the train.",
      "options": [
        [
          "A",
          "whose"
        ],
        [
          "B",
          "who"
        ],
        [
          "C",
          "that"
        ],
        [
          "D",
          "where"
        ]
      ],
      "answer": "C",
      "rationale": "that：book在定语从句作left宾语用that；who指人，whose需名词，where地点状语不能补宾语。"
    },
    {
      "number": 5,
      "stem": "We were glad ____ that nobody had been hurt.",
      "options": [
        [
          "A",
          "to hear"
        ],
        [
          "B",
          "hear"
        ],
        [
          "C",
          "hears"
        ],
        [
          "D",
          "heard"
        ]
      ],
      "answer": "A",
      "rationale": "to hear：gladtodo听到内容，tohear；hear缺to，heard/hears限定式不作该补语。"
    },
    {
      "number": 6,
      "stem": "Could you tell me ____ the station is? I cannot find it on this map.",
      "options": [
        [
          "A",
          "how often"
        ],
        [
          "B",
          "where"
        ],
        [
          "C",
          "whose"
        ],
        [
          "D",
          "when"
        ]
      ],
      "answer": "B",
      "rationale": "where：找station地点where；when时间/whose归属/howoften频率不符map找地。"
    },
    {
      "number": 7,
      "stem": "He checked the address ____ before sending the parcel.",
      "options": [
        [
          "A",
          "careful"
        ],
        [
          "B",
          "careless"
        ],
        [
          "C",
          "carefully"
        ],
        [
          "D",
          "care"
        ]
      ],
      "answer": "C",
      "rationale": "carefully：checked方式副词carefully；careful/careless形容词，care名词/动词不作此状语。"
    },
    {
      "number": 8,
      "stem": "There are ____ eggs in the fridge, only one. We need more for the cake.",
      "options": [
        [
          "A",
          "few"
        ],
        [
          "B",
          "a little"
        ],
        [
          "C",
          "much"
        ],
        [
          "D",
          "little"
        ]
      ],
      "answer": "A",
      "rationale": "few：eggs可数复数且仅一需更多，用few表不足；little/much/alittle用于不可数，不配eggs。"
    },
    {
      "number": 9,
      "stem": "—Thank you for explaining the rule. —____.",
      "options": [
        [
          "A",
          "You are welcome"
        ],
        [
          "B",
          "Yes, I do"
        ],
        [
          "C",
          "I am afraid not"
        ],
        [
          "D",
          "Good luck"
        ]
      ],
      "answer": "A",
      "rationale": "You are welcome：Youwelcome答谢；afraidnot婉拒，YesIdo回答do问句，Goodluck祝愿不答感谢。"
    },
    {
      "number": 10,
      "stem": "When the rescue team arrived, the family ____ already left the building.",
      "options": [
        [
          "A",
          "are"
        ],
        [
          "B",
          "will"
        ],
        [
          "C",
          "had"
        ],
        [
          "D",
          "has"
        ]
      ],
      "answer": "C",
      "rationale": "had：过去arrived之前left用had；has现在完成，will后非left，are不与left构成本句主动离开完成结构。"
    }

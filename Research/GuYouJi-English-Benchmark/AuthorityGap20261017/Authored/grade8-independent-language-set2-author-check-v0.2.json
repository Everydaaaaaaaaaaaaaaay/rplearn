  "review_response_tasks": [
    {
      "number": 1,
      "stem": "That is Mei’s coat. This blue one is ____. I bought it yesterday.",
      "options": [
        [
          "A",
          "me"
        ],
        [
          "B",
          "my"
        ],
        [
          "C",
          "mine"
        ],
        [
          "D",
          "I"
        ]
      ],
      "answer": "C",
      "rationale": "mine：空后无名词，mine名词性物主；my需名词，me宾格/I主格不表coat归属。"
    },
    {
      "number": 2,
      "stem": "The club first opened ____ 2021.",
      "options": [
        [
          "A",
          "to"
        ],
        [
          "B",
          "on"
        ],
        [
          "C",
          "in"
        ],
        [
          "D",
          "at"
        ]
      ],
      "answer": "C",
      "rationale": "in：年份用in；on具体日、at时点、to方向不合年份搭配。"
    },
    {
      "number": 3,
      "stem": "The road was closed, ____ we took another route.",
      "options": [
        [
          "A",
          "unless"
        ],
        [
          "B",
          "so"
        ],
        [
          "C",
          "because"
        ],
        [
          "D",
          "if"
        ]
      ],
      "answer": "B",
      "rationale": "so：封路是改道原因，so引已发生结果；because倒置因果，if/unless会把已给事实变条件且不合两已叙事件关系。"
    },
    {
      "number": 4,
      "stem": "This ruler is ____ than the old one.",
      "options": [
        [
          "A",
          "longest"
        ],
        [
          "B",
          "length"
        ],
        [
          "C",
          "longer"
        ],
        [
          "D",
          "long"
        ]
      ],
      "answer": "C",
      "rationale": "longer：than提示比较级longer；long无比较、longest最高、length名词不合表语比较。"
    },
    {
      "number": 5,
      "stem": "—____ I return the book today? —Yes. It is due this afternoon.",
      "options": [
        [
          "A",
          "Are"
        ],
        [
          "B",
          "Does"
        ],
        [
          "C",
          "Must"
        ],
        [
          "D",
          "Is"
        ]
      ],
      "answer": "C",
      "rationale": "Must：Must+I+return构成询问必须，答Yes且到期解释义务；Does与I不合且须do结构，Is/Are不能接return原形且I不配其数人称。"
    },
    {
      "number": 6,
      "stem": "—____ did you stay in the village? —For three days.",
      "options": [
        [
          "A",
          "How often"
        ],
        [
          "B",
          "How long"
        ],
        [
          "C",
          "How far"
        ],
        [
          "D",
          "How much"
        ]
      ],
      "answer": "B",
      "rationale": "How long：for3days时长，Howlong；far距离、much数量价、often频率不符。"
    },
    {
      "number": 7,
      "stem": "The little dog ____ beside the door every evening.",
      "options": [
        [
          "A",
          "waits"
        ],
        [
          "B",
          "waiting"
        ],
        [
          "C",
          "wait"
        ],
        [
          "D",
          "to wait"
        ]
      ],
      "answer": "A",
      "rationale": "waits：dog单数habit waits；wait数错，waiting/to wait非限定谓语。"
    },
    {
      "number": 8,
      "stem": "We ____ the old house yesterday and took some photos.",
      "options": [
        [
          "A",
          "visited"
        ],
        [
          "B",
          "visit"
        ],
        [
          "C",
          "visiting"
        ],
        [
          "D",
          "visits"
        ]
      ],
      "answer": "A",
      "rationale": "visited：yesterday限定过去visited并列took；visit/visits现在，visiting非限定。"
    },
    {
      "number": 9,
      "stem": "At eight last night, I ____ dinner when the phone rang.",
      "options": [
        [
          "A",
          "have cooked"
        ],
        [
          "B",
          "was cooking"
        ],
        [
          "C",
          "will cook"
        ],
        [
          "D",
          "cook"
        ]
      ],
      "answer": "B",
      "rationale": "was cooking：过去具体时点进行中被rang打断，wascooking；其余现在/将来/现在完成不合该过去进程。"
    },
    {
      "number": 10,
      "stem": "If the rain stops tomorrow, we ____ the match outside.",
      "options": [
        [
          "A",
          "playing"
        ],
        [
          "B",
          "will play"
        ],
        [
          "C",
          "has played"
        ],
        [
          "D",
          "played"
        ]
      ],
      "answer": "B",
      "rationale": "will play：if未来条件主句willplay；played过去、playing缺谓语、hasplayed主语we数错且过去完成与明日不合。"
    },
    {
      "number": 11,
      "stem": "Of the three bags, this one is the ____.",
      "options": [
        [
          "A",
          "lightly"
        ],
        [
          "B",
          "light"
        ],
        [
          "C",
          "lighter"
        ],
        [
          "D",
          "lightest"
        ]
      ],
      "answer": "D",
      "rationale": "lightest：三者范围the最高级lightest；lighter为两项比较形式，light原级，lightly副词非包的表语形容词。"
    },
    {
      "number": 12,
      "stem": "The teacher asked us ____ the windows before leaving.",
      "options": [
        [
          "A",
          "closing"
        ],
        [
          "B",
          "close"
        ],
        [
          "C",
          "to close"
        ],
        [
          "D",
          "closed"
        ]
      ],
      "answer": "C",
      "rationale": "to close：asksbto do宾补toclose；close缺to，closed/closing不作此ask结构宾补。"
    }

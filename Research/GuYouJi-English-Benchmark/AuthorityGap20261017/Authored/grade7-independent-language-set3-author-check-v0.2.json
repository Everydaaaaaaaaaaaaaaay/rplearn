    {
      "number": 1,
      "stem": "These are my cousins. ____ live near the river.",
      "options": [
        [
          "A",
          "Their"
        ],
        [
          "B",
          "They"
        ],
        [
          "C",
          "Them"
        ]
      ],
      "answer": "B",
      "rationale": "They：主语复数They；Them宾格，Their需名词，不作此live主语。"
    },
    {
      "number": 2,
      "stem": "The family usually has a picnic ____ spring.",
      "options": [
        [
          "A",
          "in"
        ],
        [
          "B",
          "at"
        ],
        [
          "C",
          "on"
        ]
      ],
      "answer": "A",
      "rationale": "in：spring季节搭配in；on具体日、at时点不合。"
    },
    {
      "number": 3,
      "stem": "The answer is not sixteen ____ sixty.",
      "options": [
        [
          "A",
          "but"
        ],
        [
          "B",
          "so"
        ],
        [
          "C",
          "because"
        ]
      ],
      "answer": "A",
      "rationale": "but：not sixteen but sixty纠正两个数；so/because后不接单独数字完成该并列。"
    },
    {
      "number": 4,
      "stem": "—How often does Jo visit the library? —____.",
      "options": [
        [
          "A",
          "On the second floor"
        ],
        [
          "B",
          "At three o’clock"
        ],
        [
          "C",
          "Twice a week"
        ]
      ],
      "answer": "C",
      "rationale": "Twice a week：Twiceaweek频率；atthree时点，secondfloor地点，不答howoften。"
    },
    {
      "number": 5,
      "stem": "____ your sister play the piano after dinner?",
      "options": [
        [
          "A",
          "Are"
        ],
        [
          "B",
          "Do"
        ],
        [
          "C",
          "Does"
        ]
      ],
      "answer": "C",
      "rationale": "Does：sister单数实义play问句Does；Do数不合，Are不能接play且数不合。"
    },
    {
      "number": 6,
      "stem": "There ____ a red umbrella behind the door.",
      "options": [
        [
          "A",
          "have"
        ],
        [
          "B",
          "are"
        ],
        [
          "C",
          "is"
        ]
      ],
      "answer": "C",
      "rationale": "is：aredumbrella单数用is；are数不符，have不构成该therebe句。"
    },
    {
      "number": 7,
      "stem": "—____ is the school trip? —On Friday.",
      "options": [
        [
          "A",
          "Where"
        ],
        [
          "B",
          "When"
        ],
        [
          "C",
          "Who"
        ]
      ],
      "answer": "B",
      "rationale": "When：OnFriday时间答When；Where地点、Who人物不合。"
    },
    {
      "number": 8,
      "stem": "Our teacher ____ us a story every Monday.",
      "options": [
        [
          "A",
          "telling"
        ],
        [
          "B",
          "tells"
        ],
        [
          "C",
          "tell"
        ]
      ],
      "answer": "B",
      "rationale": "tells：teacher单数习惯tells；tell数不合，telling缺限定助动词。"
    },
    {
      "number": 9,
      "stem": "Please be quiet. The baby ____ now.",
      "options": [
        [
          "A",
          "slept"
        ],
        [
          "B",
          "sleep"
        ],
        [
          "C",
          "is sleeping"
        ]
      ],
      "answer": "C",
      "rationale": "is sleeping：安静提示现在睡，is sleeping；sleep单数谓语不合，slept过去不合now。"
    },
    {
      "number": 10,
      "stem": "Next week I ____ take these books back.",
      "options": [
        [
          "A",
          "does"
        ],
        [
          "B",
          "will"
        ],
        [
          "C",
          "am"
        ]
      ],
      "answer": "B",
      "rationale": "will：will+take原形；am不能接原形take，does与I数不合且非本句将来陈述。"
    }

  "review_response_tasks": [
    {
      "number": 1,
      "stem": "How did Tom get to school today?",
      "options": [
        [
          "A",
          "On foot."
        ],
        [
          "B",
          "By bike."
        ],
        [
          "C",
          "By bus."
        ]
      ],
      "answer": "A",
      "rationale": "已发生去程步行；B轮胎瘪，C为若下雨返程打算。"
    },
    {
      "number": 2,
      "stem": "Where will they shop?",
      "options": [
        [
          "A",
          "At the Monday market."
        ],
        [
          "B",
          "At the shop near the station."
        ],
        [
          "C",
          "At the school cafe."
        ]
      ],
      "answer": "B",
      "rationale": "市场周一关，改车站旁店；A不可，C无。"
    },
    {
      "number": 3,
      "stem": "What do they need to buy?",
      "options": [
        [
          "A",
          "Tomatoes and rice."
        ],
        [
          "B",
          "Rice and milk."
        ],
        [
          "C",
          "Tomatoes and milk."
        ]
      ],
      "answer": "A",
      "rationale": "米和番茄要买，奶已足；B/C混入不用买的奶。"
    },
    {
      "number": 4,
      "stem": "When should the speakers arrive?",
      "options": [
        [
          "A",
          "At three."
        ],
        [
          "B",
          "At a quarter to three."
        ],
        [
          "C",
          "At half past two."
        ]
      ],
      "answer": "C",
      "rationale": "2:30到、3点开；A混开场，B无。"
    },
    {
      "number": 5,
      "stem": "What will Lucy do in the play?",
      "options": [
        [
          "A",
          "Watch it as a visitor."
        ],
        [
          "B",
          "Act as a shopkeeper."
        ],
        [
          "C",
          "Sell the tickets at the door."
        ]
      ],
      "answer": "B",
      "rationale": "明确参演店主；A先前误以为，C非戏角色。"
    }
  ],

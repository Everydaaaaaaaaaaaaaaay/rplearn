      "number": 1,
      "stem": "What does the woman suggest the man do?",
      "options": [
        [
          "A",
          "Buy a camera."
        ],
        [
          "B",
          "Charge the camera."
        ],
        [
          "C",
          "Change the date of the trip."
        ]
      ],
      "answer": "B",
      "rationale": "B由Plug it in tonight与empty battery支持；A她同意借出，无须买；C没有建议改出行日期。"
    },
    {
      "number": 2,
      "stem": "When does the dance class start on Friday?",
      "options": [
        [
          "A",
          "At 2:50."
        ],
        [
          "B",
          "At 3:10."
        ],
        [
          "C",
          "At 3:30."
        ]
      ],
      "answer": "A",
      "rationale": "3:10提前20分钟为2:50；B是周一至周四常规时间；C把提前当推迟。"
    },
    {
      "number": 3,
      "stem": "Where are the speakers probably?",
      "options": [
        [
          "A",
          "At a hotel."
        ],
        [
          "B",
          "At a railway station."
        ],
        [
          "C",
          "In a clothes shop."
        ]
      ],
      "answer": "C",
      "rationale": "试穿尺码、袖长和fitting room共同定位服装店；A酒店和B车站不能解释服装试穿情境。"
    },
    {
      "number": 4,
      "stem": "What is the man most likely to be?",
      "options": [
        [
          "A",
          "A sports coach."
        ],
        [
          "B",
          "A dentist."
        ],
        [
          "C",
          "A chef."
        ]
      ],
      "answer": "B",
      "rationale": "拔牙、局部numb与停止治疗手势共同支持牙医；A无运动，C无烹饪。录音场景虚构，不作医疗建议。"
    },
    {
      "number": 5,
      "stem": "How does the woman feel?",
      "options": [
        [
          "A",
          "Delighted."
        ],
        [
          "B",
          "Indifferent."
        ],
        [
          "C",
          "Disappointed."
        ]
      ],
      "answer": "C",
      "rationale": "期待带哥哥看演出却无票、what a pity表失望；A高兴相反，B冷漠与期待矛盾。"
    }

  "review_response_tasks": [
    {
      "number": 1,
      "stem": "The paint is wet. Keep your hands off it. Don't ____ it.",
      "options": [
        [
          "A",
          "touch"
        ],
        [
          "B",
          "look at"
        ],
        [
          "C",
          "walk past"
        ]
      ],
      "answer": "A",
      "rationale": "A：keep your hands off明确不要碰，对应touch。；B：看不等于手碰，不是这条提醒所禁动作。；C：从旁走过不等于手碰，不合明确的hands off。"
    },
    {
      "number": 2,
      "stem": "—Is this a storybook? —____ It has stories in it.",
      "options": [
        [
          "A",
          "No, it isn't."
        ],
        [
          "B",
          "Yes, it is."
        ],
        [
          "C",
          "I don't know."
        ]
      ],
      "answer": "B",
      "rationale": "A：后句说明有故事，与否定storybook冲突。；B：后句说明故事内容，支持肯定。；C：后文提供明确故事依据，不合此处不知道。"
    },
    {
      "number": 3,
      "stem": "Five books are inside the bag. —What are those ____ the bag? —____ books.",
      "options": [
        [
          "A",
          "in; It's"
        ],
        [
          "B",
          "on; They're"
        ],
        [
          "C",
          "in; They're"
        ]
      ],
      "answer": "C",
      "rationale": "A：those books为复数，不能用It is。；B：题面inside不是on表面。；C：inside对应in，books复数对应They are。"
    },
    {
      "number": 4,
      "stem": "—What's this? —____ You can drink from it.",
      "options": [
        [
          "A",
          "It's a cup."
        ],
        [
          "B",
          "She's my mum."
        ],
        [
          "C",
          "He's my brother."
        ]
      ],
      "answer": "A",
      "rationale": "A：cup是可以从中喝水的物品。；B：介绍母亲不回答可用来喝水的物品。；C：介绍哥哥或弟弟，不合物品问题。"
    },
    {
      "number": 5,
      "stem": "—____ my cap? —It's on the chair.",
      "options": [
        [
          "A",
          "What's"
        ],
        [
          "B",
          "Where's"
        ],
        [
          "C",
          "Who's"
        ]
      ],
      "answer": "B",
      "rationale": "A：问身份，不能由on the chair的位置直接回答。；B：询问帽子位置，由椅子上回答。；C：问人物不合cap和位置回答。"
    },
    {
      "number": 6,
      "stem": "—Look at this little rabbit. —____ cute!",
      "options": [
        [
          "A",
          "What"
        ],
        [
          "B",
          "What a"
        ],
        [
          "C",
          "How"
        ]
      ],
      "answer": "C",
      "rationale": "A：不能单接cute结束此感叹结构。；B：后面缺单数名词，结构不完整。；C：How cute为完整的形容词感叹。"
    },
    {
      "number": 7,
      "stem": "—Do you have an ____? —Yes, I do.",
      "options": [
        [
          "A",
          "cap"
        ],
        [
          "B",
          "apple"
        ],
        [
          "C",
          "dogs"
        ]
      ],
      "answer": "B",
      "rationale": "A：cap是辅音音素开头，不用an。；B：apple为元音音素开头的单数词。；C：复数dogs不能跟an。"
    },
    {
      "number": 8,
      "stem": "—Are these ____? —No, ____.",
      "options": [
        [
          "A",
          "pigs; they aren't"
        ],
        [
          "B",
          "pig; they aren't"
        ],
        [
          "C",
          "pigs; they are"
        ]
      ],
      "answer": "A",
      "rationale": "A：these pigs复数一致，No接否定。；B：these后不能用单数pig。；C：与No的否定回答冲突。"
    },
    {
      "number": 9,
      "stem": "—Would you like some juice? —____",
      "options": [
        [
          "A",
          "Yes, I do."
        ],
        [
          "B",
          "See you."
        ],
        [
          "C",
          "Yes, please."
        ]
      ],
      "answer": "C",
      "rationale": "A：此邀请的自然礼貌接受不以do照答。；B：告别语不回答是否要果汁。；C：礼貌接受饮料邀请。"
    },
    {
      "number": 10,
      "stem": "My cap is black and orange. —What colour is your cap? —____",
      "options": [
        [
          "A",
          "Blue and white."
        ],
        [
          "B",
          "Black and orange."
        ],
        [
          "C",
          "Red and green."
        ]
      ],
      "answer": "B",
      "rationale": "A：与题面帽子颜色不符。；B：与题面明确给出的颜色一致。；C：与题面颜色不符。"
    }

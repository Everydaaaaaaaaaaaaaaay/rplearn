  "review_response_tasks": [
    {
      "number": 1,
      "stem": "A friend says, \"Thank you for returning my notebook.\" You reply, \"____\"",
      "options": [
        [
          "A",
          "You are welcome."
        ],
        [
          "B",
          "Excuse me."
        ],
        [
          "C",
          "I am sorry."
        ],
        [
          "D",
          "See you tomorrow."
        ]
      ],
      "answer": "A",
      "rationale": "A：回应对方的感谢。；B：请求引起注意，不回应感谢。；C：道歉，题面未有过错。；D：告别，未回应感谢。"
    },
    {
      "number": 2,
      "stem": "To find which page explains how to make the paper boat, look at the book's ____.",
      "options": [
        [
          "A",
          "cover colour"
        ],
        [
          "B",
          "price"
        ],
        [
          "C",
          "author photo"
        ],
        [
          "D",
          "contents"
        ]
      ],
      "answer": "D",
      "rationale": "A：封面颜色不提供内容页码。；B：价格不提供内容页码。；C：作者照片不提供内容页码。；D：目录提供内容和页码。"
    },
    {
      "number": 3,
      "stem": "The wooden stool is ____ than the metal chair.",
      "options": [
        [
          "A",
          "light"
        ],
        [
          "B",
          "lightest"
        ],
        [
          "C",
          "lighter"
        ],
        [
          "D",
          "more lighter"
        ]
      ],
      "answer": "C",
      "rationale": "A：light为原级。；B：lightest为最高级。；C：than前用比较级lighter。；D：more与lighter重复。"
    },
    {
      "number": 4,
      "stem": "The hall opens at two. We arrived at 1:50, ten minutes ____.",
      "options": [
        [
          "A",
          "lately"
        ],
        [
          "B",
          "early"
        ],
        [
          "C",
          "nearly"
        ],
        [
          "D",
          "softly"
        ]
      ],
      "answer": "B",
      "rationale": "A：lately表示近来。；B：比开门提前十分钟。；C：nearly不能在这里作时间差补语。；D：softly表示轻柔的方式。"
    },
    {
      "number": 5,
      "stem": "I was tuning the guitar when the bell rang. Ask about the activity: ____ were you doing ____ the bell rang?",
      "options": [
        [
          "A",
          "What, when"
        ],
        [
          "B",
          "Where, what"
        ],
        [
          "C",
          "When, what"
        ],
        [
          "D",
          "What, who"
        ]
      ],
      "answer": "A",
      "rationale": "A：What问活动，when引出响铃时刻。；B：Where不问活动，what不连接此从句。；C：When不问所做活动，第二空what不合此从句。；D：who不能连接the bell rang作时间从句。"
    },
    {
      "number": 6,
      "stem": "The music lesson begins ____ three o'clock on Tuesdays.",
      "options": [
        [
          "A",
          "in"
        ],
        [
          "B",
          "on"
        ],
        [
          "C",
          "between"
        ],
        [
          "D",
          "at"
        ]
      ],
      "answer": "D",
      "rationale": "A：in不用于此钟点。；B：on不用于此钟点。；C：between需要成对端点，不直接用于此单点。；D：钟点前用at。"
    },
    {
      "number": 7,
      "stem": "The three students ____ the stage when I entered yesterday.",
      "options": [
        [
          "A",
          "was cleaning"
        ],
        [
          "B",
          "were cleaning"
        ],
        [
          "C",
          "is cleaning"
        ],
        [
          "D",
          "am cleaning"
        ]
      ],
      "answer": "B",
      "rationale": "A：was不与复数students一致。；B：复数students与过去时were cleaning一致。；C：is不与复数主语及过去语境一致。；D：am只与I搭配。"
    },
    {
      "number": 8,
      "stem": "This rope is much ____ than the thin string.",
      "options": [
        [
          "A",
          "thick"
        ],
        [
          "B",
          "thickest"
        ],
        [
          "C",
          "thicker"
        ],
        [
          "D",
          "more thicker"
        ]
      ],
      "answer": "C",
      "rationale": "A：thick是原级。；B：thickest是最高级。；C：比较级thicker与much及than相配。；D：more与thicker重复。"
    },
    {
      "number": 9,
      "stem": "The lamp is bright ____ for us to read the small labels.",
      "options": [
        [
          "A",
          "enough"
        ],
        [
          "B",
          "much"
        ],
        [
          "C",
          "many"
        ],
        [
          "D",
          "most"
        ]
      ],
      "answer": "A",
      "rationale": "A：bright enough to read表达亮度足够。；B：much不放在bright后构成此结构。；C：many不构成此形容词结构。；D：most不构成此形容词结构。"
    },
    {
      "number": 10,
      "stem": "This is ____ drum in our cupboard.",
      "options": [
        [
          "A",
          "smallest"
        ],
        [
          "B",
          "smaller"
        ],
        [
          "C",
          "the smallest"
        ],
        [
          "D",
          "small"
        ]
      ],
      "answer": "C",
      "rationale": "A：单数可数名词前缺限定词。；B：smaller前缺限定词。；C：the smallest作定语修饰drum。；D：small前缺限定词。"
    }

      "number": 1,
      "stem": "How did Ben go to the park?",
      "options": [
        [
          "A",
          "By bus."
        ],
        [
          "B",
          "By car."
        ],
        [
          "C",
          "On foot."
        ]
      ],
      "answer": "B",
      "rationale": "去程爸爸开车，返程才乘公交；C无步行。"
    },
    {
      "number": 2,
      "stem": "Which club will Amy join?",
      "options": [
        [
          "A",
          "The football club."
        ],
        [
          "B",
          "The music club."
        ],
        [
          "C",
          "The art club."
        ]
      ],
      "answer": "C",
      "rationale": "实际决定周五美术；A与音乐课冲突，B是课非所选社团。"
    },
    {
      "number": 3,
      "stem": "What does Amy need to bring?",
      "options": [
        [
          "A",
          "An old shirt."
        ],
        [
          "B",
          "Some paint."
        ],
        [
          "C",
          "A football."
        ]
      ],
      "answer": "A",
      "rationale": "俱乐部有颜料，只需旧衬衣；B已供，C非美术所需。"
    },
    {
      "number": 4,
      "stem": "When should the children meet?",
      "options": [
        [
          "A",
          "At a quarter past nine."
        ],
        [
          "B",
          "At half past nine."
        ],
        [
          "C",
          "At nine."
        ]
      ],
      "answer": "C",
      "rationale": "9点集合、9:15发车；A混发车时间，B未安排。"
    },
    {
      "number": 5,
      "stem": "Why should they bring lunch?",
      "options": [
        [
          "A",
          "They will spend all day on the bus."
        ],
        [
          "B",
          "The museum cafe is closed."
        ],
        [
          "C",
          "There is no garden at the museum."
        ]
      ],
      "answer": "B",
      "rationale": "咖啡厅本周关闭；A不符参观，C明确有花园。"
    }

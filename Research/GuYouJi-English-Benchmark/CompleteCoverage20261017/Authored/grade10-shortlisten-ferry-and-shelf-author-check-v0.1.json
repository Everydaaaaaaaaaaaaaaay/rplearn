  "review_response_tasks": [
    {
      "number": 1,
      "stem": "What is the woman's problem?",
      "options": [
        [
          "A",
          "The numbers are too small to read."
        ],
        [
          "B",
          "The journey takes too long."
        ],
        [
          "C",
          "She has lost the timetable."
        ]
      ],
      "answer": "A",
      "rationale": "tiny numbers与without glasses定位字小；B她否认旅程问题，C没有丢时刻表。"
    },
    {
      "number": 2,
      "stem": "When will the last ferry leave today?",
      "options": [
        [
          "A",
          "At 6:40."
        ],
        [
          "B",
          "At 6:55."
        ],
        [
          "C",
          "At 7:15."
        ]
      ],
      "answer": "B",
      "rationale": "6:40推迟15分钟为6:55；A未计延迟，C把原时刻误当七点再加15。"
    },
    {
      "number": 3,
      "stem": "Where does the conversation probably take place?",
      "options": [
        [
          "A",
          "At a theatre ticket desk."
        ],
        [
          "B",
          "At an airport check-in desk."
        ],
        [
          "C",
          "At a restaurant entrance."
        ]
      ],
      "answer": "A",
      "rationale": "balcony seats/performance/stage door共同指剧院售票；B无航班，C无用餐。"
    },
    {
      "number": 4,
      "stem": "What does the man probably do?",
      "options": [
        [
          "A",
          "He cooks meals."
        ],
        [
          "B",
          "He makes clothes."
        ],
        [
          "C",
          "He makes wooden furniture."
        ]
      ],
      "answer": "C",
      "rationale": "测量木板、裁切并装木架支持木工家具；A和B与材料和操作不符。"
    },
    {
      "number": 5,
      "stem": "How does the woman feel now?",
      "options": [
        [
          "A",
          "Angry."
        ],
        [
          "B",
          "Relieved."
        ],
        [
          "C",
          "Lonely."
        ]
      ],
      "answer": "B",
      "rationale": "thank goodness与stop worrying支持如释重负；A生气、C孤独无依据。"
    }
  ],

      "number": 1,
      "stem": "What information are visitors asking for?",
      "options": [
        [
          "A",
          "Who owns the boards."
        ],
        [
          "B",
          "When the photographs were taken."
        ],
        [
          "C",
          "How much the prints cost."
        ]
      ],
      "answer": "B",
      "rationale": "开头when they were taken直接支持B；A/C未询问。"
    },
    {
      "number": 2,
      "stem": "What does the woman suggest for the uncertain dates?",
      "options": [
        [
          "A",
          "Showing the uncertainty clearly."
        ],
        [
          "B",
          "Choosing an exact year at random."
        ],
        [
          "C",
          "Removing every photograph."
        ]
      ],
      "answer": "A",
      "rationale": "保留两图，日期加问号解释；B错误精确，C过度扩大删除。"
    },
    {
      "number": 3,
      "stem": "What should be displayed on the board?",
      "options": [
        [
          "A",
          "The original prints."
        ],
        [
          "B",
          "The empty envelopes."
        ],
        [
          "C",
          "Copies of the photographs."
        ]
      ],
      "answer": "C",
      "rationale": "只copies上板，originals留封套；A有损坏风险，B非照片展示。"
    },
    {
      "number": 4,
      "stem": "Why does the man need a portable screen?",
      "options": [
        [
          "A",
          "The projector has no power cable."
        ],
        [
          "B",
          "The small room has no screen."
        ],
        [
          "C",
          "The cupboard is being repaired."
        ]
      ],
      "answer": "B",
      "rationale": "W直接说明小房间无屏；A/C没有设备或柜子损坏信息。"
    },
    {
      "number": 5,
      "stem": "When must the projector be returned?",
      "options": [
        [
          "A",
          "Saturday afternoon."
        ],
        [
          "B",
          "Monday morning."
        ],
        [
          "C",
          "Sunday evening."
        ]
      ],
      "answer": "C",
      "rationale": "原提周一被更正为周日晚，另组周一先测试；A为借用时间，B已不适用投影仪。"
    },
    {
      "number": 6,
      "stem": "Who should receive the projector?",
      "options": [
        [
          "A",
          "The caretaker at the side entrance."
        ],
        [
          "B",
          "The worker in the main office."
        ],
        [
          "C",
          "The leader of the Monday group."
        ]
      ],
      "answer": "A",
      "rationale": "星期天办公室关闭，交侧门caretaker并登记；B/C非指定接收者。"
    },
    {
      "number": 7,
      "stem": "What does the speaker emphasise about returning seeds?",
      "options": [
        [
          "A",
          "It is required before borrowing."
        ],
        [
          "B",
          "It is an invitation rather than a condition."
        ],
        [
          "C",
          "It must be done within a week."
        ]
      ],
      "answer": "B",
      "rationale": "开头明确invitation notcondition；A/C把希望误作硬性限期。"
    },
    {
      "number": 8,
      "stem": "What information is on the envelope label?",
      "options": [
        [
          "A",
          "The seed collector's address."
        ],
        [
          "B",
          "The price of a mature plant."
        ],
        [
          "C",
          "The year the seed was collected."
        ]
      ],
      "answer": "C",
      "rationale": "列植物名、采集年、空间需求；A/C之外的B售价均未印。"
    },
    {

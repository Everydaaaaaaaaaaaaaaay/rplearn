// Debug 真机默认沿用正式身份；协作者可在不入库的本地文件中覆盖 Team 与 Bundle ID。
#include "Signing.xcconfig"
#include? "Signing.local.xcconfig"

// 模拟器不需要签名。显式清空签名身份与团队，避免 Xcode 查询登录钥匙串。
CODE_SIGNING_ALLOWED[sdk=iphonesimulator*] = NO
CODE_SIGNING_REQUIRED[sdk=iphonesimulator*] = NO
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] =
DEVELOPMENT_TEAM[sdk=iphonesimulator*] =
PROVISIONING_PROFILE_SPECIFIER[sdk=iphonesimulator*] =

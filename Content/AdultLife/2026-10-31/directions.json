          "shot": "lunch",
          "act": 2,
          "speed": 0.98,
          "after": 0.6
        },
        "ML20": {
          "shot": "evening",
          "act": 1,
          "speed": 1.0,
          "after": 0.35,
          "outcomes": [
            "Marcus 查班表后给出两个时间，尚未确认。",

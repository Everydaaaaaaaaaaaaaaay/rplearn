          "shot": "dinner",
          "act": 1,
          "speed": 1.0,
          "after": 0.35,
          "outcomes": [
            "双方说定故事内周二新加坡时间十九点通话。",
            "双方暂不确认周二，等到家再商量。"
          ],
          "insertAfter": [
            {
              "english": "That time fits. The call would be twenty minutes.",
              "lines": [
                [
                  "Mei",
                  "Just tea. I don't need a slide show.",
                  "就喝茶聊聊，不用给我放幻灯片。"
                ]
              ]
            }
          ],
          "question": [
            "Book it now, or wait until you get home?",
            "现在定下来，还是到家后再商量？"
          ]
        },
        "SG11": {
          "shot": "dinner",
          "act": 2,
          "speed": 0.98,
          "after": 0.6
        },
        "SG12": {
          "shot": "dinner",
          "act": 2,
          "speed": 0.98,
          "after": 0.6,
          "insertAfter": [
            {
              "english": "You finish dinner without looking for another date.",
              "lines": [
                [
                  "旁白",
                  "A cleaner passes. Mei stacks the empty bowls.",
                  "清洁人员走过，Mei 把空碗叠起来。"
                ]
              ]
            }
          ]
        },
        "SG20": {
          "shot": "dinner",
          "act": 1,
          "speed": 1.0,
          "after": 0.35,
          "outcomes": [
            "双方同意拍一张只留给两人的合照。",
            "你们收起手机，把今晚的饭慢慢吃完。"
          ],
          "question": [
            "What would you like before you go?",
            "离开之前，你想做什么？"
          ]
        },
        "SG21": {
          "shot": "night",
          "act": 2,
          "speed": 0.98,
          "after": 0.6,
          "insertAfter": [
            {
              "english": "Yes. Just for us, though.",
              "lines": [
                [
                  "Mei",
                  "I don't want to post every goodbye.",
                  "我不想把每一次告别都发到网上。"
                ]
              ]
            }
          ]
        },
        "SG22": {
          "shot": "dinner",
          "act": 2,
          "speed": 0.98,
          "after": 0.6
        }
      }

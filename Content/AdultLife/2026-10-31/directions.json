          "act": 2,
          "speed": 0.98,
          "after": 0.6,
          "insertAfter": [
            {
              "english": "Which way are you going? I'll walk with you.",
              "lines": [
                [
                  "旁白",
                  "You point towards your next stop. He follows your lead.",
                  "你指向接下来要去的方向，他跟着你走。"
                ]
              ]
            },
            {
              "english": "I know the words. That's worse. See you.",
              "lines": [
                [
                  "旁白",
                  "He stops at the corner. He doesn't add another block.",
                  "他走到街角就停下，没有再拉着你多走一个街区。"
                ]
              ]
            }
          ]

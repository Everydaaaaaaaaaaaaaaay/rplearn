          ],
          "question": [
            "Do you still want to meet today?",
            "你今天还想见面吗？"
          ]
        },
        "ML10": {
          "shot": "meet",
          "act": 1,
          "speed": 1.0,
          "after": 0.35,
          "outcomes": [
            "Marcus 陪你走到街角，一点半分开。",
            "你们在桌边短坐，Marcus 自己另找午饭。"
          ],
          "cuts": [
            {
              "from": 0,
              "shot": "lunch"
            },
            {
              "from": 4,
              "shot": "meet"
            }
          ],
          "question": [
            "What fits the time you have left?",
            "剩下的时间，你想怎么过？"

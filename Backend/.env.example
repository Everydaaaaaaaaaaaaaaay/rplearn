# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=debug
TRUST_PROXY=false
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
# OpenTelemetry is opt-in. The OTLP headers variable may contain a collector
# credential and must come from Secret Manager rather than this file.
OTEL_TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=3000
OTEL_TRACE_SAMPLE_RATIO=0.1
OTEL_SERVICE_NAME=
APP_VERSION=0.1.0-dev
AUDIT_RETENTION_DAYS=365
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=10000
ACCOUNT_DELETION_GRACE_DAYS=7
ACCOUNT_DELETION_RECEIPT_RETENTION_DAYS=2555
HTTP_GLOBAL_IP_MINUTE_LIMIT=3000

# Operator-only control plane. Expose /internal/admin only through a private
# ingress. Comma-separated rotation keys: key-id=at-least-32-character-token.
ADMIN_API_ENABLED=false
ADMIN_API_KEYS=

# PostgreSQL is the authoritative store. Redis only holds disposable state.
DATABASE_URL=postgres://127.0.0.1:5432/lingotrip
# Only migration jobs receive this separate DDL credential. Local development
# may leave it empty and fall back to DATABASE_URL.
MIGRATION_DATABASE_URL=
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_MS=20000
DATABASE_CONNECT_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:6379
REDIS_CONNECT_TIMEOUT_MS=5000
READINESS_TIMEOUT_MS=2000

# Private S3-compatible user media. Enable it only when local MinIO is running.
MEDIA_STORAGE_ENABLED=false
MEDIA_S3_BUCKET=lingotrip-media-dev
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=http://127.0.0.1:9000
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_S3_ACCESS_KEY_ID=lingotrip_dev
MEDIA_S3_SECRET_ACCESS_KEY=lingotrip_dev_only
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_DOWNLOAD_URL_TTL_SECONDS=300
MEDIA_PENDING_TTL_HOURS=24
MEDIA_MAX_VOICE_BYTES=20971520
MEDIA_USER_ASSET_LIMIT=10000
MEDIA_USER_STORAGE_BYTES=1073741824
MEDIA_RECORD_RETENTION_DAYS=30

# Authentication. Development generates an ephemeral Ed25519 key when the key
# fields are empty. Production must inject persistent keys and a unique pepper.
AUTH_ISSUER=https://rplearn.haruyuki.cn
AUTH_AUDIENCE=lingotrip-clients
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_ACTION_TOKEN_TTL_SECONDS=3600
AUTH_LOGIN_IP_15M_LIMIT=60
AUTH_LOGIN_ACCOUNT_15M_LIMIT=10
AUTH_EMAIL_IP_HOUR_LIMIT=30
AUTH_EMAIL_ACCOUNT_HOUR_LIMIT=5
AUTH_TOKEN_HASH_PEPPER=
AUTH_JWT_KEY_ID=
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=
# Comma-separated historical verification keys: old-kid=BASE64_SPKI_PEM
AUTH_JWT_PREVIOUS_PUBLIC_KEYS=
AUTH_ACTION_URL_BASE=http://localhost:3000/auth
AUTH_EMAIL_FROM=LingoTrip <no-reply@local.lingotrip>

# Optional local Mailpit uses SMTP 1025 and exposes its inbox UI on 8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Durable background jobs. Payloads contain sensitive action tokens and are
# encrypted at rest. Production must inject a stable 32-byte base64 key.
JOB_PAYLOAD_ENCRYPTION_KEY_BASE64=
JOB_PAYLOAD_KEY_VERSION=
# Comma-separated historical decryption keys: previous-v1=BASE64,previous-v0=BASE64
JOB_PAYLOAD_PREVIOUS_KEYS=
JOB_LEASE_SECONDS=60
JOB_POLL_INTERVAL_MS=1000
JOB_RETRY_BASE_SECONDS=30
JOB_RETENTION_DAYS=14

# Sign in with Apple is opt-in until Apple Developer credentials are configured.
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_IDS=com.tiantian.lingotrip
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=
APPLE_CREDENTIAL_ENCRYPTION_KEY_BASE64=
APPLE_CREDENTIAL_KEY_VERSION=
APPLE_REDIRECT_URI=
APPLE_CHALLENGE_TTL_SECONDS=300
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_TOKEN_ENDPOINT=https://appleid.apple.com/auth/token
APPLE_REVOCATION_ENDPOINT=https://appleid.apple.com/auth/revoke

# App Store Server API / Notifications V2. Root certificates are public
# Apple PKI DER certificates, comma-separated and base64 encoded.
APPLE_BILLING_ENABLED=false
APPLE_BILLING_BUNDLE_ID=com.tiantian.lingotrip
APPLE_BILLING_APP_APPLE_ID=
APPLE_BILLING_ROOT_CA_CERTIFICATES_BASE64=
APPLE_BILLING_ENABLE_ONLINE_CHECKS=true
# In-App Purchase key from App Store Connect. Keep this separate from the
# Sign in with Apple credential above.
APPLE_BILLING_ISSUER_ID=
APPLE_BILLING_KEY_ID=
APPLE_BILLING_PRIVATE_KEY_BASE64=
APPLE_BILLING_RECONCILE_BATCH_SIZE=100
APPLE_BILLING_RECONCILE_ACTIVE_HOURS=6
APPLE_BILLING_RECONCILE_INACTIVE_HOURS=24
APPLE_BILLING_RECONCILE_RETRY_MINUTES=15

# The AI key is a runtime secret. Keep this file empty and use an untracked
# Backend/.env locally or a Secret Manager in deployed environments.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_ALLOWED_MODELS=deepseek-v4-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=LingoTrip
OPENROUTER_SITE_URL=https://rplearn.haruyuki.cn
# Required with OPENROUTER_API_KEY. Pin a reviewed settlement rate; route revisions
# and request ledgers retain the price snapshot used for each call.
OPENROUTER_USD_TO_CNY=
AI_GUEST_ACCESS_ENABLED=true
AI_RETRY_MAX_ATTEMPTS=2
AI_USAGE_RETENTION_DAYS=90
AI_USER_MINUTE_LIMIT=30

# 公共学习题库补充；不扣用户聊天额度。初批候选必须逐题审核后发布。
LEARNING_GENERATION_ENABLED=false
# 公共课程生成和独立审题共用既有 OpenRouter 凭据。
LEARNING_GENERATION_MODEL=openai/gpt-6-luna
# UTC 每日最多取得的生成租约数；每次最多作者/审题两次请求，崩溃不退预算。
LEARNING_GENERATION_DAILY_JOBS=6

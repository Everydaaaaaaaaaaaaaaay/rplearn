# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=debug
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=10000

# The AI key is a runtime secret. Keep this file empty and use an untracked
# Backend/.env locally or a Secret Manager in deployed environments.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

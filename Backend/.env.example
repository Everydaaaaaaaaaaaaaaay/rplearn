# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=debug
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=10000

# PostgreSQL is the authoritative store. Redis only holds disposable state.
DATABASE_URL=postgres://lingotrip:lingotrip_dev@127.0.0.1:54329/lingotrip
DATABASE_MAX_CONNECTIONS=10
DATABASE_IDLE_TIMEOUT_MS=20000
DATABASE_CONNECT_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:63799
REDIS_CONNECT_TIMEOUT_MS=5000
READINESS_TIMEOUT_MS=2000

# The AI key is a runtime secret. Keep this file empty and use an untracked
# Backend/.env locally or a Secret Manager in deployed environments.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

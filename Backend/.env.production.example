# Deployment identity
PUBLIC_HOST=rplearn.haruyuki.cn
ADMIN_HOST=coovingo.com
APP_VERSION=replace-with-an-immutable-release-id

# Database and Redis (generate unique values; do not reuse these placeholders)
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
REDIS_PASSWORD=

# Authentication and encrypted background jobs
AUTH_ISSUER=https://rplearn.haruyuki.cn
AUTH_AUDIENCE=lingotrip-clients
AUTH_ACTION_URL_BASE=https://rplearn.haruyuki.cn/auth
AUTH_EMAIL_FROM=LingoTrip <no-reply@rplearn.haruyuki.cn>
AUTH_TOKEN_HASH_PEPPER=
AUTH_JWT_KEY_ID=
AUTH_JWT_PRIVATE_KEY_BASE64=
AUTH_JWT_PUBLIC_KEY_BASE64=
AUTH_JWT_PREVIOUS_PUBLIC_KEYS=
JOB_PAYLOAD_ENCRYPTION_KEY_BASE64=
JOB_PAYLOAD_KEY_VERSION=production-v1
JOB_PAYLOAD_PREVIOUS_KEYS=

# Public HTTP policy and protected operational endpoints
CORS_ALLOWED_ORIGINS=https://rplearn.haruyuki.cn
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
ADMIN_API_ENABLED=false
ADMIN_API_KEYS=

# AI gateway
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_DEEPSEEK_ALLOWED_MODELS=deepseek-v4-flash
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=LingoTrip
OPENROUTER_SITE_URL=https://rplearn.haruyuki.cn
OPENROUTER_USD_TO_CNY=
AI_GUEST_ACCESS_ENABLED=true

# Private S3-compatible media storage
MEDIA_STORAGE_ENABLED=true
MEDIA_S3_BUCKET=lingotrip-media
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ENDPOINT=https://rplearn.haruyuki.cn
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# Replace the local capture service with a transactional SMTP provider before
# public account registration is enabled.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Apple integrations stay disabled until real Developer/App Store Connect
# credentials are injected.
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_IDS=com.tiantian.lingotrip
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=
APPLE_CREDENTIAL_ENCRYPTION_KEY_BASE64=
APPLE_CREDENTIAL_KEY_VERSION=production-v1
# Native iOS login leaves this empty. Set it only for a configured Services ID.
APPLE_REDIRECT_URI=
APPLE_BILLING_ENABLED=false
APPLE_BILLING_BUNDLE_ID=com.tiantian.lingotrip

# Runtime
LOG_LEVEL=info
TRUST_PROXY=true
OTEL_TRACING_ENABLED=false

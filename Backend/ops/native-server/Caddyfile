{
	admin off
}

{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}

	route {
		@private path /internal/*
		respond @private 404

		handle_path /npc-avatars/* {
			root * /srv/lingotrip/npc-avatars
			@portrait file
			header @portrait Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@media path /{$MEDIA_S3_BUCKET}/*
		reverse_proxy @media 127.0.0.1:9000

		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}
}

{$ADMIN_HOST} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	route {
		@root path /
		redir @root /internal/admin/ai 302

		@admin_console path /internal/admin/ai /internal/admin/ai/* /internal/admin/learning /internal/admin/learning/*
		reverse_proxy @admin_console 127.0.0.1:8080 {
			flush_interval -1
		}

		respond 404
	}
}

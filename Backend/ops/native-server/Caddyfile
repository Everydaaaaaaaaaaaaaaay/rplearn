{
	admin off
}

{$PUBLIC_HOST} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
	}

	route {
		@private path /internal/*
		respond @private 404

		@media path /{$MEDIA_S3_BUCKET}/*
		reverse_proxy @media 127.0.0.1:9000

		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}
}

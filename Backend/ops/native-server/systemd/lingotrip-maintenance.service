[Unit]
Description=LingoTrip operational data retention cleanup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=lingotrip
Group=lingotrip
WorkingDirectory=/opt/lingotrip/current
EnvironmentFile=/etc/lingotrip/backend.env
EnvironmentFile=/etc/lingotrip/release.env
Environment=PATH=/opt/lingotrip/runtime/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/lingotrip/runtime/bin/node dist/cli/cleanup-operational-data.js
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

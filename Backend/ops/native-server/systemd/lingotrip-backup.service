[Unit]
Description=LingoTrip native PostgreSQL and media backup
After=postgresql.service lingotrip-minio.service
Requires=postgresql.service lingotrip-minio.service

[Service]
Type=oneshot
ExecStart=/opt/lingotrip/backend/ops/native-server/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/lingotrip/backups

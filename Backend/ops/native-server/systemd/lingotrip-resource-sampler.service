[Unit]
Description=LingoTrip 主机资源留档

[Service]
Type=oneshot
ExecStart=/opt/lingotrip/ops/native-server/resource-guard.py record
User=root
UMask=0027
MemoryMax=48M
MemorySwapMax=0
CPUQuota=10%
Nice=19
IOWeight=1
TimeoutStartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/lingotrip
ProtectHome=true
PrivateTmp=true

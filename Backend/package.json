{
  "name": "@lingotrip/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "auth:generate-keys": "tsx src/cli/generate-auth-keys.ts",
    "billing:reconcile": "tsx src/cli/reconcile-apple-billing.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm architecture && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "learning:validate": "tsx src/cli/learning-catalog.ts validate",
    "learning:publish": "tsx src/cli/learning-catalog.ts publish",
    "maintenance:cleanup": "tsx src/cli/cleanup-operational-data.ts",
    "npc-avatars:import": "tsx src/cli/import-npc-avatars.ts",
    "architecture": "depcruise --config dependency-cruiser.cjs src",
    "production:check": "tsx src/cli/check-production-readiness.ts",
    "start": "node --import ./dist/instrumentation-loader.js --import ./dist/instrumentation.js dist/server.js",
    "start:worker": "node --import ./dist/instrumentation-loader.js --import ./dist/instrumentation.js dist/worker.js",
    "test": "vitest run",
    "test:e2e": "pnpm build && cross-env RUN_E2E_TESTS=true vitest run --maxWorkers=1 --no-file-parallelism test/e2e",
    "test:integration": "cross-env RUN_INTEGRATION_TESTS=true vitest run --maxWorkers=1 --no-file-parallelism test/integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker.ts",
    "usage:report": "tsx src/cli/usage-report.ts",
    "credits:report": "tsx src/cli/credit-ledger.ts report",
    "credits:reconcile": "tsx src/cli/credit-ledger.ts reconcile"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/otel": "0.20.1",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/instrumentation": "0.221.0",
    "@opentelemetry/instrumentation-http": "0.221.0",
    "@opentelemetry/instrumentation-undici": "0.31.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace": "2.10.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "jose": "^6.2.4",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "15.1.3",
    "redis": "^6.1.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "dependency-cruiser": "^18.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}

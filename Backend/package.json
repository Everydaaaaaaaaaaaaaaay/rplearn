{
  "name": "@lingotrip/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "auth:generate-keys": "tsx src/cli/generate-auth-keys.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:up": "docker compose up -d --wait",
    "lint": "eslint .",
    "maintenance:cleanup": "tsx src/cli/cleanup-operational-data.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:integration": "cross-env RUN_INTEGRATION_TESTS=true DATABASE_URL=postgres://lingotrip:lingotrip_dev@127.0.0.1:54329/lingotrip REDIS_URL=redis://127.0.0.1:63799 vitest run --maxWorkers=1 --no-file-parallelism test/integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "jose": "^6.2.4",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "prom-client": "15.1.3",
    "redis": "^6.1.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
